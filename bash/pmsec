#!/usr/bin/env bash
# pmsec — zero-config install-time supply-chain hardening for
# npm / pnpm / yarn / bun / cargo / mise / uv / bundler / aube / composer. `enable` writes the cooldown
# plus every safe-by-default key the tool exposes (audit-level, trust-policy,
# hardened mode, attestation re-verification, ...). `--days N` overrides the
# default cooldown.
# Bash port. Works without npm/uv installed; only needs bash 3.2+ and coreutils.
# License: MIT.
# SPDX-License-Identifier: MIT
set +u

PMSEC_VERSION="2026.11.8"
# Default cooldown for the hardening bundle. Override per-invocation with
# `--days N`; the default tracks the safest value we'd recommend.
BUNDLE_DAYS=1
TOOLS=(npm pnpm yarn bun cargo mise uv bundler aube composer)

# ---------- paths ----------

# `PMSEC_HOME` wins over `$HOME` so a single env var can redirect every
# per-tool path — orchestrators (Jamf, Intune, Ansible, SCCM, scheduled
# tasks, …) need this when running as root/SYSTEM against another user's
# profile.
_pmsec_home() {
  if [ -n "${PMSEC_HOME:-}" ]; then printf '%s' "$PMSEC_HOME"; return; fi
  printf '%s' "$HOME"
}

# `stat`'s flags differ between BSD (macOS) and GNU coreutils (Linux); try
# both, fall back to empty on platforms with neither.
_pmsec_stat() {
  stat -c "$2" "$3" 2>/dev/null || stat -f "$1" "$3" 2>/dev/null || printf ''
}

_pmsec_owner_of() {
  local p="$1"
  [ -d "$p" ] || return 0
  _pmsec_stat '%Su' '%U' "$p"
}

path_npmrc() {
  if [ -n "${NPM_CONFIG_USERCONFIG:-}" ]; then printf '%s' "$NPM_CONFIG_USERCONFIG"; return; fi
  printf '%s/.npmrc' "$(_pmsec_home)"
}
# pnpm reads its global rc separately from ~/.npmrc; writing pnpm-only keys
# here keeps npm from warning (and, in npm 12, erroring) about unknown user
# config. pnpm respects XDG_CONFIG_HOME on every OS.
path_pnpm() {
  local home; home=$(_pmsec_home)
  if [ -n "${PMSEC_PNPM_CONFIG_FILE:-}" ]; then printf '%s' "$PMSEC_PNPM_CONFIG_FILE"; return; fi
  if [ -n "${XDG_CONFIG_HOME:-}" ]; then printf '%s/pnpm/rc' "$XDG_CONFIG_HOME"; return; fi
  if [ "${PMSEC_PLATFORM:-}" = "darwin" ]; then printf '%s/Library/Preferences/pnpm/rc' "$home"; return; fi
  if [ "${PMSEC_PLATFORM:-}" = "win32" ]; then
    printf '%s/pnpm/config/rc' "${LOCALAPPDATA:-$home/AppData/Local}"; return
  fi
  printf '%s/.config/pnpm/rc' "$home"
}
# pnpm >= 11 reads pnpm-specific settings from config.yaml (camelCase) instead
# of the registry/auth-only rc file. Keep it next to the rc path so custom
# PMSEC_PNPM_CONFIG_FILE overrides remain self-contained.
path_pnpm_config_yaml() {
  if [ -n "${PMSEC_PNPM_CONFIG_YAML:-}" ]; then printf '%s' "$PMSEC_PNPM_CONFIG_YAML"; return; fi
  printf '%s/config.yaml' "$(dirname -- "$(path_pnpm)")"
}
path_uv() {
  local home; home=$(_pmsec_home)
  if [ -n "${UV_CONFIG_FILE:-}" ]; then printf '%s' "$UV_CONFIG_FILE"; return; fi
  if [ "${PMSEC_PLATFORM:-}" = "win32" ]; then
    printf '%s/uv/uv.toml' "${APPDATA:-$home/AppData/Roaming}"; return
  fi
  printf '%s/uv/uv.toml' "${XDG_CONFIG_HOME:-$home/.config}"
}
# bun reads $XDG_CONFIG_HOME/.bunfig.toml *instead of* $HOME/.bunfig.toml
# whenever XDG_CONFIG_HOME is set to an absolute path.
path_bun() {
  if [ -n "${BUN_CONFIG_FILE:-}" ]; then printf '%s' "$BUN_CONFIG_FILE"; return; fi
  case "${XDG_CONFIG_HOME:-}" in
    /*) printf '%s/.bunfig.toml' "$XDG_CONFIG_HOME"; return ;;
  esac
  printf '%s/.bunfig.toml' "$(_pmsec_home)"
}
path_yarn() {
  if [ -n "${YARN_RC_FILENAME:-}" ]; then printf '%s' "$YARN_RC_FILENAME"; return; fi
  printf '%s/.yarnrc.yml' "$(_pmsec_home)"
}
path_cargo() {
  if [ -n "${CARGO_HOME:-}" ]; then printf '%s/config.toml' "$CARGO_HOME"; return; fi
  printf '%s/.cargo/config.toml' "$(_pmsec_home)"
}
# Bundler's global config. BUNDLE_USER_CONFIG points at the file directly;
# BUNDLE_USER_HOME points at the home dir (config = <home>/config). Both
# default to ~/.bundle, matching bundler's own resolution order.
path_bundler() {
  if [ -n "${BUNDLE_USER_CONFIG:-}" ]; then printf '%s' "$BUNDLE_USER_CONFIG"; return; fi
  if [ -n "${BUNDLE_USER_HOME:-}" ]; then printf '%s/config' "$BUNDLE_USER_HOME"; return; fi
  printf '%s/.bundle/config' "$(_pmsec_home)"
}
path_mise() {
  local home; home=$(_pmsec_home)
  if [ -n "${MISE_GLOBAL_CONFIG_FILE:-}" ]; then printf '%s' "$MISE_GLOBAL_CONFIG_FILE"; return; fi
  # mise reads its global config from MISE_CONFIG_DIR when set, so the legacy
  # destination must follow it; a default-path write would leave the active
  # config without the bundle after a downgrade migration.
  if [ -n "${MISE_CONFIG_DIR:-}" ]; then printf '%s/config.toml' "$MISE_CONFIG_DIR"; return; fi
  if [ "${PMSEC_PLATFORM:-}" = "win32" ]; then
    printf '%s/mise/config.toml' "${LOCALAPPDATA:-$home/AppData/Local}"; return
  fi
  printf '%s/mise/config.toml' "${XDG_CONFIG_HOME:-$home/.config}"
}
# mise's global config directory (https://mise.jdx.dev/directories.html).
# Unlike the legacy single-file path above this is the same on every OS:
# win32 uses %USERPROFILE%/.config/mise, not %LOCALAPPDATA%/mise.
path_mise_dir() {
  local home; home=$(_pmsec_home)
  if [ -n "${MISE_CONFIG_DIR:-}" ]; then printf '%s' "$MISE_CONFIG_DIR"; return; fi
  if [ -n "${XDG_CONFIG_HOME:-}" ]; then printf '%s/mise' "$XDG_CONFIG_HOME"; return; fi
  printf '%s/.config/mise' "$home"
}
path_mise_base() { printf '%s/config.toml' "$(path_mise_dir)"; }
path_mise_pmsec() { printf '%s/config.pmsec.toml' "$(path_mise_dir)"; }
path_mise_local_miserc() { printf '%s/miserc.local.toml' "$(path_mise_dir)"; }
path_mise_shared_miserc() { printf '%s/miserc.toml' "$(path_mise_dir)"; }
path_mise_system_miserc() {
  local home
  if [ -n "${MISE_SYSTEM_CONFIG_DIR:-}" ]; then printf '%s/miserc.toml' "$MISE_SYSTEM_CONFIG_DIR"; return; fi
  if [ "${PMSEC_PLATFORM:-}" = "win32" ]; then
    home=$(_pmsec_home)
    if [[ "$home" == [A-Za-z]:* ]]; then printf '%s/etc/mise/miserc.toml' "${home:0:2}"; return; fi
  fi
  printf '/etc/mise/miserc.toml'
}
path_aube() {
  local home; home=$(_pmsec_home)
  if [ -n "${AUBE_CONFIG_FILE:-}" ]; then printf '%s' "$AUBE_CONFIG_FILE"; return; fi
  if [ "${PMSEC_PLATFORM:-}" = "win32" ]; then
    printf '%s/aube/config.toml' "${LOCALAPPDATA:-$home/AppData/Local}"; return
  fi
  printf '%s/aube/config.toml' "${XDG_CONFIG_HOME:-$home/.config}"
}
# Composer keeps its global config in $COMPOSER_HOME/config.json. The default
# COMPOSER_HOME follows platform conventions (XDG on Unix, Application Support
# on macOS, APPDATA on Windows), matching Composer's own resolution. An
# explicit XDG_CONFIG_HOME wins on every non-Windows platform, including macOS.
# Mirrors Composer's Factory::getHomeDir: COMPOSER_HOME, else %APPDATA%/Composer
# on Windows, else (when any XDG_* variable is set or /etc/xdg exists) the
# first existing of $XDG_CONFIG_HOME/composer and ~/.composer, defaulting to
# the XDG one; without XDG, ~/.composer. Composer never uses Application
# Support on macOS.
path_composer() {
  local home; home=$(_pmsec_home)
  if [ -n "${COMPOSER_HOME:-}" ]; then printf '%s/config.json' "$COMPOSER_HOME"; return; fi
  if [ "${PMSEC_PLATFORM:-}" = "win32" ]; then
    printf '%s/Composer/config.json' "${APPDATA:-$home/AppData/Roaming}"; return
  fi
  local use_xdg=0 d
  if env | grep -q '^XDG_' || [ -d /etc/xdg ]; then use_xdg=1; fi
  local dirs=()
  [ "$use_xdg" = 1 ] && dirs+=("${XDG_CONFIG_HOME:-$home/.config}/composer")
  dirs+=("$home/.composer")
  for d in "${dirs[@]}"; do
    if [ -d "$d" ]; then printf '%s/config.json' "$d"; return; fi
  done
  printf '%s/config.json' "${dirs[0]}"
}

# ---------- line buffer ----------
# Mirrors node/src/util/lines.mjs. Operates on global LINES_BUF, joined with '\n'
# plus a trailing newline iff the resulting buffer is non-empty.
LINES_BUF=()

lines_load() {
  local path="$1" line
  LINES_BUF=()
  [ -f "$path" ] || return 0
  # Normalize CRLF to LF and drop a UTF-8 BOM, matching the other ports.
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    [ "${#LINES_BUF[@]}" -eq 0 ] && line="${line#$'\xEF\xBB\xBF'}"
    LINES_BUF[${#LINES_BUF[@]}]="$line"
  done < "$path"
}

# SCAN_BUF mirrors LINES_BUF with the body of TOML multi-line strings blanked,
# so text inside them is never taken for a header or key. Indices stay aligned.
# Context-aware: delimiters inside comments or single-line strings are not
# structural, so `# uses """` or `note = "it's '''"` cannot hide a real key.
SCAN_BUF=()
lines_scan() {
  local n=${#LINES_BUF[@]} i open="" j len line ch tok q inside
  SCAN_BUF=()
  for ((i=0; i<n; i++)); do
    inside="$open"
    line="${LINES_BUF[i]}"
    j=0; len=${#line}
    while (( j < len )); do
      if [ -n "$open" ]; then
        # Inside a multiline basic string a backslash escapes the next char,
        # so `\"""` does not close the delimiter; literal strings have none.
        if [ "$open" = '"""' ] && [ "${line:j:1}" = '\' ]; then j=$((j+2)); continue; fi
        # One or two content quotes may precede the closing delimiter, so a
        # four-/five-quote run closes on its final three quotes.
        local closing=0
        while [ "${line:$((j+closing)):1}" = "${open:0:1}" ]; do
          closing=$((closing+1))
          [ "$closing" -lt "5" ] || break
        done
        if [ "$closing" = "4" ] || [ "$closing" = "5" ]; then open=""; j=$((j+closing)); continue; fi
        if [ "$closing" = "3" ]; then open=""; j=$((j+3)); continue; fi
        j=$((j+1))
        continue
      fi
      ch="${line:j:1}"
      if [ "$ch" = "#" ]; then break; fi
      if [ "$ch" = '"' ] || [ "$ch" = "'" ]; then
        tok="${line:j:3}"
        if [ "$tok" = '"""' ] || [ "$tok" = "'''" ]; then open="$tok"; j=$((j+3)); continue; fi
        # Single-line string: `\"` cannot close a basic string, so a `'''`
        # inside never opens a multi-line string. Unterminated strings end
        # with the line, so invalid TOML cannot poison later lines.
        q="$ch"; j=$((j+1))
        while (( j < len )); do
          ch="${line:j:1}"
          if [ "$q" = '"' ] && [ "$ch" = "\\" ]; then j=$((j+2)); continue; fi
          if [ "$ch" = "$q" ]; then j=$((j+1)); break; fi
          j=$((j+1))
        done
        continue
      fi
      j=$((j+1))
    done
    if [ -n "$inside" ]; then SCAN_BUF[i]=""; else SCAN_BUF[i]="${LINES_BUF[i]}"; fi
  done
}

lines_dump() {
  local n=${#LINES_BUF[@]} i
  if [ "$n" -eq 0 ]; then return 0; fi
  for ((i=0; i<n; i++)); do printf '%s\n' "${LINES_BUF[i]}"; done
}

# TOML tables may carry a trailing comment, inner whitespace, quoted names, or be [[arrays]].
LINES_SECTION_RE='^[[:space:]]*\[\[?[^][]+\]\]?[[:space:]]*(#.*)?$'
LINES_HEADER_RE='^[[:space:]]*\[([^][]+)\][[:space:]]*(#.*)?$'
LINES_KEY_RE="(\"[^\"]*\"|'[^']*'|[A-Za-z0-9_.-]+)"

lines_is_section() {
  [[ "$1" =~ $LINES_SECTION_RE ]]
}

lines_unquote() {
  local s="$1"
  if [[ "$s" =~ ^\".*\"$ || "$s" =~ ^\'.*\'$ ]]; then s="${s:1:${#s}-2}"; fi
  printf '%s' "$s"
}

lines_trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  printf '%s' "${s%"${s##*[![:space:]]}"}"
}

# Print the normalized table name of a [header] line, or return 1.
lines_header_name() {
  [[ "$1" =~ $LINES_HEADER_RE ]] || return 1
  local IFS=. part out=() p
  read -r -a part <<< "${BASH_REMATCH[1]}"
  for p in "${part[@]}"; do out[${#out[@]}]=$(lines_unquote "$(lines_trim "$p")"); done
  printf '%s' "${out[*]}"
}

# YAML nests by indentation, so only unindented `key:` lines are top-level.
lines_indent_re() {
  if [ "$1" = ":" ]; then printf '^'; else printf '^[[:space:]]*'; fi
}

# Print the key for "key=value" / "key: value", or empty.
lines_entry_key() {
  local re="$(lines_indent_re "$2")${LINES_KEY_RE}[[:space:]]*$2"
  [[ "$1" =~ $re ]] || return 1
  lines_unquote "${BASH_REMATCH[1]}"
}

# Print the value after the separator with any trailing comment removed.
lines_entry_value() {
  local re="$(lines_indent_re "$2")${LINES_KEY_RE}[[:space:]]*$2[[:space:]]*(.*)$" v close rest
  [[ "$1" =~ $re ]] || return 1
  v=$(lines_trim "${BASH_REMATCH[2]}")
  case "${v:0:1}" in '"') close='"' ;; "'") close="'" ;; '{') close='}' ;; esac
  if [ -n "$close" ]; then
    rest="${v:1}"
    if [[ "$rest" == *"$close"* ]]; then
      rest="${rest%%"$close"*}"
      printf '%s' "${v:0:1}$rest$close"; return 0
    fi
  fi
  v="${v%%[[:space:]]#*}"
  printf '%s' "${v%"${v##*[![:space:]]}"}"
}

# Echo "start end" for the section's [start, end) range, or empty string if
# the named section is missing. With section="", returns the head region
# (lines before the first section header).
lines_section_range() {
  local section="$1" n=${#LINES_BUF[@]} i name
  if [ -z "$section" ]; then
    for ((i=0; i<n; i++)); do
      if lines_is_section "${SCAN_BUF[i]}"; then printf '0 %d' "$i"; return 0; fi
    done
    printf '0 %d' "$n"; return 0
  fi
  local start=-1 end=$n
  for ((i=0; i<n; i++)); do
    name=$(lines_header_name "${SCAN_BUF[i]}") || continue
    if [ "$name" = "$section" ]; then start=$((i+1)); break; fi
  done
  if [ "$start" -lt 0 ]; then return 0; fi
  for ((i=start; i<n; i++)); do
    if lines_is_section "${SCAN_BUF[i]}"; then end=$i; break; fi
  done
  printf '%d %d' "$start" "$end"
}

lines_index_of_key() {
  local key="$1" sep="$2" start="$3" end="$4" i k
  for ((i=start; i<end; i++)); do
    k=$(lines_entry_key "${SCAN_BUF[i]}" "$sep") || continue
    if [ "$k" = "$key" ]; then printf '%d' "$i"; return 0; fi
  done
  printf '%d' "-1"
}

# TOML forbids `a.b = x` under [s] when [s.a] exists or `a` is an inline table.
# Sets RES_KEY/RES_SECTION to the subtable target, or RES_INLINE/RES_HEAD to
# the inline-table line to edit in place (RES_INLINE=-1 otherwise).
lines_resolve() {
  RES_KEY="$1" RES_SECTION="$3" RES_INLINE=-1 RES_HEAD=""
  # A table defined at the root through dotted keys (`s.k = v`) or an inline
  # table (`s = { ... }`) cannot also get a [s] header, so keep editing it there.
  if [ -n "$3" ] && [ "$2" = "=" ] && [ -z "$(lines_section_range "$3")" ]; then
    local root i k v
    root=$(lines_section_range "")
    for ((i=0; i<${root#* }; i++)); do
      k=$(lines_entry_key "${SCAN_BUF[i]}" "=") || continue
      if [[ "$k" == "$3."* ]]; then RES_KEY="$3.$1" RES_SECTION=""; return 0; fi
      if [ "$k" = "$3" ]; then
        v=$(lines_entry_value "${SCAN_BUF[i]}" "=")
        if [ "${v:0:1}" = "{" ]; then RES_SECTION="" RES_INLINE=$i RES_HEAD="$3"; return 0; fi
      fi
    done
  fi
  if [ -n "$3" ] && [ "$2" = "=" ] && [[ "$1" == *.* ]]; then
    local head="${1%%.*}" range idx val
    if [ -n "$(lines_section_range "$3.$head")" ]; then RES_KEY="${1#*.}" RES_SECTION="$3.$head"; return 0; fi
    range=$(lines_section_range "$3")
    [ -n "$range" ] || return 0
    idx=$(lines_index_of_key "$head" "$2" "${range% *}" "${range#* }")
    [ "$idx" != "-1" ] || return 0
    val=$(lines_entry_value "${LINES_BUF[idx]}" "=")
    if [ "${val:0:1}" = "{" ]; then RES_KEY="${1#*.}" RES_INLINE=$idx RES_HEAD="$head"; fi
  fi
}

# Load the inline table pairs of LINES_BUF[$1] into INLINE_PAIRS.
lines_inline_pairs() {
  local v body p parts IFS=,
  INLINE_PAIRS=()
  v=$(lines_entry_value "${LINES_BUF[$1]}" "=")
  body="${v:1}"; body="${body%\}}"
  read -r -a parts <<< "$body"
  for p in "${parts[@]}"; do
    p=$(lines_trim "$p")
    [ -n "$p" ] && INLINE_PAIRS[${#INLINE_PAIRS[@]}]="$p"
  done
  return 0
}

# Rewrite LINES_BUF[$1] as `head = { INLINE_PAIRS... }`, keeping indentation.
lines_inline_write() {
  local line="${LINES_BUF[$1]}" indent inner="" p
  indent="${line%%[![:space:]]*}"
  for p in "${INLINE_PAIRS[@]}"; do inner="${inner:+$inner, }$p"; done
  LINES_BUF[$1]="$indent$2 = {${inner:+ $inner }}"
}

lines_first_section_idx() {
  local n=${#LINES_BUF[@]} i
  for ((i=0; i<n; i++)); do
    if lines_is_section "${SCAN_BUF[i]}"; then printf '%d' "$i"; return 0; fi
  done
  printf '%d' "-1"
}

# Print the value of $key inside the (optional) section. Return 1 if missing.
lines_read_key() {
  local key="$1" sep="${2:-=}" section="${3:-}" range start end idx p
  lines_scan
  lines_resolve "$key" "$sep" "$section"; key="$RES_KEY" section="$RES_SECTION"
  if [ "$RES_INLINE" != "-1" ]; then
    lines_inline_pairs "$RES_INLINE"
    for p in "${INLINE_PAIRS[@]}"; do
      if [ "$(lines_entry_key "$p" "$sep")" = "$key" ]; then lines_entry_value "$p" "$sep"; return; fi
    done
    return 1
  fi
  range=$(lines_section_range "$section")
  [ -n "$range" ] || return 1
  start="${range% *}"; end="${range#* }"
  idx=$(lines_index_of_key "$key" "$sep" "$start" "$end")
  [ "$idx" != "-1" ] || return 1
  lines_entry_value "${LINES_BUF[idx]}" "$sep"
}

# Insert items from $@ at index $1, shifting the tail right.
_lines_splice_in() {
  local pos="$1"; shift
  local n=${#LINES_BUF[@]} out=() i v
  for ((i=0; i<pos; i++)); do out[${#out[@]}]="${LINES_BUF[i]}"; done
  for v in "$@"; do out[${#out[@]}]="$v"; done
  for ((i=pos; i<n; i++)); do out[${#out[@]}]="${LINES_BUF[i]}"; done
  LINES_BUF=()
  for ((i=0; i<${#out[@]}; i++)); do LINES_BUF[i]="${out[i]}"; done
}

_lines_splice_out() {
  local pos="$1" len="$2" n=${#LINES_BUF[@]} out=() i
  for ((i=0; i<pos; i++)); do out[${#out[@]}]="${LINES_BUF[i]}"; done
  for ((i=pos+len; i<n; i++)); do out[${#out[@]}]="${LINES_BUF[i]}"; done
  LINES_BUF=()
  for ((i=0; i<${#out[@]}; i++)); do LINES_BUF[i]="${out[i]}"; done
}

# Set or replace a key=value (or key: value) line within an optional section.
lines_set_key() {
  local key="$1" value_line="$2" sep="${3:-=}" section="${4:-}"
  local n=${#LINES_BUF[@]} range start end idx first_sec
  lines_scan
  lines_resolve "$key" "$sep" "$section"
  if [ "$RES_KEY" != "$key" ]; then value_line="$RES_KEY${value_line:${#key}}"; fi
  key="$RES_KEY" section="$RES_SECTION"
  if [ "$RES_INLINE" != "-1" ]; then
    local i found=0
    lines_inline_pairs "$RES_INLINE"
    for ((i=0; i<${#INLINE_PAIRS[@]}; i++)); do
      if [ "$(lines_entry_key "${INLINE_PAIRS[i]}" "$sep")" = "$key" ]; then INLINE_PAIRS[i]="$value_line"; found=1; fi
    done
    [ "$found" = 1 ] || INLINE_PAIRS[${#INLINE_PAIRS[@]}]="$value_line"
    lines_inline_write "$RES_INLINE" "$RES_HEAD"
    return 0
  fi
  range=$(lines_section_range "$section")
  if [ -z "$range" ]; then
    if [ "$n" -gt 0 ] && [ -n "${LINES_BUF[n-1]}" ]; then
      LINES_BUF[$n]=""
      n=$((n+1))
    fi
    LINES_BUF[$n]="[$section]"
    LINES_BUF[$((n+1))]="$value_line"
    return 0
  fi
  start="${range% *}"; end="${range#* }"
  idx=$(lines_index_of_key "$key" "$sep" "$start" "$end")
  if [ "$idx" != "-1" ]; then
    LINES_BUF[idx]="$value_line"; return 0
  fi
  if [ -n "$section" ]; then
    _lines_splice_in "$start" "$value_line"
    return 0
  fi
  first_sec=$(lines_first_section_idx)
  # Reuse the blank line that already separates the root keys from the first table.
  if [ "$first_sec" = "-1" ]; then
    LINES_BUF[${#LINES_BUF[@]}]="$value_line"
  elif [ "$first_sec" -gt 0 ] && [ -z "${LINES_BUF[first_sec-1]}" ]; then
    _lines_splice_in "$((first_sec-1))" "$value_line"
  else
    _lines_splice_in "$first_sec" "$value_line" ""
  fi
}

# Remove a key from a section. Also drops a single trailing blank line that
# the key left behind, matching the node implementation.
lines_remove_key() {
  local key="$1" sep="${2:-=}" section="${3:-}" range start end idx n
  lines_scan
  lines_resolve "$key" "$sep" "$section"; key="$RES_KEY" section="$RES_SECTION"
  if [ "$RES_INLINE" != "-1" ]; then
    local kept=() p
    lines_inline_pairs "$RES_INLINE"
    for p in "${INLINE_PAIRS[@]}"; do
      [ "$(lines_entry_key "$p" "$sep")" = "$key" ] || kept[${#kept[@]}]="$p"
    done
    [ "${#kept[@]}" -lt "${#INLINE_PAIRS[@]}" ] || return 1
    INLINE_PAIRS=("${kept[@]}")
    lines_inline_write "$RES_INLINE" "$RES_HEAD"
    return 0
  fi
  range=$(lines_section_range "$section")
  [ -n "$range" ] || return 1
  start="${range% *}"; end="${range#* }"
  idx=$(lines_index_of_key "$key" "$sep" "$start" "$end")
  [ "$idx" != "-1" ] || return 1
  _lines_splice_out "$idx" 1
  n=${#LINES_BUF[@]}
  if [ "$idx" -lt "$n" ] && [ -z "${LINES_BUF[idx]}" ]; then
    _lines_splice_out "$idx" 1
  fi
  return 0
}

# ---------- minimal JSON object editor ----------
# Composer stores config as JSON. A full JSON parser would be overkill (and
# bash has none built in), so edit the pretty-printed object in place. Only
# the shapes pmsec needs are supported: objects of scalar members, one member
# per line. Depth arrays let us find/set/remove a member inside nested objects.

_json_scan_depth() {
  local line="$1" depth="$2" i ch in_str=0 esc=0 n=${#1}
  for ((i=0; i<n; i++)); do
    ch="${line:i:1}"
    if [ "$in_str" = "1" ]; then
      if [ "$esc" = "1" ]; then esc=0
      elif [ "$ch" = "\\" ]; then esc=1
      elif [ "$ch" = '"' ]; then in_str=0
      fi
    elif [ "$ch" = '"' ]; then in_str=1
    elif [ "$ch" = "{" ]; then depth=$((depth+1))
    elif [ "$ch" = "}" ]; then depth=$((depth-1))
    fi
  done
  printf '%d' "$depth"
}

# Split minified JSON into one structural token per line (outside strings), so
# the object editor can work regardless of how Composer/user formatted the file.
_json_normalize_lines() {
  local line cur ch rest i n in_str esc
  local -a out=()
  for line in "${LINES_BUF[@]}"; do
    cur=""; in_str=0; esc=0; n=${#line}
    for ((i=0; i<n; i++)); do
      ch="${line:i:1}"
      if [ "$in_str" = "1" ]; then
        cur+="$ch"
        if [ "$esc" = "1" ]; then esc=0
        elif [ "$ch" = "\\" ]; then esc=1
        elif [ "$ch" = '"' ]; then in_str=0
        fi
        continue
      fi
      case "$ch" in
        '"') in_str=1; cur+="$ch" ;;
        '{'|',')
          cur+="$ch"; rest="${line:i+1}"
          if [ -n "${rest//[[:space:]]/}" ]; then out[${#out[@]}]="$cur"; cur=""; fi
          ;;
        '}')
          if [ -n "${cur//[[:space:]]/}" ]; then out[${#out[@]}]="$cur"; cur=""; fi
          cur+="$ch"
          ;;
        *) cur+="$ch" ;;
      esac
    done
    if [ -n "${cur//[[:space:]]/}" ] || [ "${#out[@]}" -eq 0 ]; then out[${#out[@]}]="$cur"; fi
  done
  LINES_BUF=("${out[@]}")
}

# Populate JD_START / JD_END with brace depth before/after each line.
_json_depth_maps() {
  _json_normalize_lines
  local i depth=0 n=${#LINES_BUF[@]} after
  JD_START=(); JD_END=()
  for ((i=0; i<n; i++)); do
    JD_START[i]="$depth"
    after=$(_json_scan_depth "${LINES_BUF[i]}" "$depth")
    JD_END[i]="$after"
    depth="$after"
  done
}

# Set JR_OPEN/JR_CLOSE/JR_START/JR_END/JR_DEPTH for the root object.
_json_root_range() {
  local i n=${#LINES_BUF[@]}
  JR_OPEN=-1
  for ((i=0; i<n; i++)); do
    case "${LINES_BUF[i]}" in *'{'*) JR_OPEN=$i; break ;; esac
  done
  [ "$JR_OPEN" -ge 0 ] || return 1
  local base="${JD_START[JR_OPEN]}" close=-1
  if [ "${JD_END[JR_OPEN]}" = "$base" ]; then
    close=$JR_OPEN
  else
    for ((i=JR_OPEN+1; i<n; i++)); do
      if [ "${JD_END[i]}" = "$base" ]; then close=$i; break; fi
    done
  fi
  [ "$close" -ge 0 ] || return 1
  JR_CLOSE=$close; JR_START=$((JR_OPEN+1)); JR_END=$close; JR_DEPTH=$((base+1))
  return 0
}

# Set JR_* for an object at a path (pass one or more member names).
_json_object_range() {
  _json_depth_maps || return 1
  _json_root_range || return 1
  local key i idx open base close
  for key in "$@"; do
    idx=-1
    for ((i=JR_START; i<JR_END; i++)); do
      [ "${JD_START[i]}" = "$JR_DEPTH" ] || continue
      if [[ "${LINES_BUF[i]}" =~ ^[[:space:]]*\"$key\"[[:space:]]*: ]]; then idx=$i; break; fi
    done
    [ "$idx" -ge 0 ] || return 1
    open=-1
    for ((i=idx; i<JR_END; i++)); do
      case "${LINES_BUF[i]}" in *'{'*) open=$i; break ;; esac
    done
    [ "$open" -ge 0 ] || return 1
    base="${JD_START[idx]}"
    if [ "${JD_END[open]}" = "$base" ]; then
      close=$open
    else
      close=-1
      for ((i=open+1; i<JR_END; i++)); do
        if [ "${JD_END[i]}" = "$base" ]; then close=$i; break; fi
      done
    fi
    [ "$close" -ge 0 ] || return 1
    JR_OPEN=$open; JR_CLOSE=$close; JR_START=$((open+1)); JR_END=$close; JR_DEPTH=$((base+1))
  done
  return 0
}

_json_indent() {
  local level="$1" out="" i
  for ((i=0; i<level; i++)); do out+="  "; done
  printf '%s' "$out"
}

_json_last_content_line() {
  local range_start="$1" range_end="$2" i
  JLC=-1
  for ((i=range_end-1; i>=range_start; i--)); do
    if [ -n "${LINES_BUF[i]//[[:space:]]/}" ]; then JLC=$i; return 0; fi
  done
  return 1
}

_json_ensure_comma() {
  local start="$1" end="$2"
  if _json_last_content_line "$start" "$end"; then
    case "${LINES_BUF[JLC]}" in
      *,|*,[[:space:]]) ;;
      *) LINES_BUF[JLC]="${LINES_BUF[JLC]}," ;;
    esac
  fi
}

# Turn `"config": {}` into a multi-line empty object.
_json_expand_empty_object() {
  local open="$1" close="$2" level="$3" line head tail in_str=0 esc=0 i ch oi=-1 ci=-1 n
  [ "$open" = "$close" ] || return 1
  line="${LINES_BUF[open]}"; n=${#line}
  for ((i=0; i<n; i++)); do
    ch="${line:i:1}"
    if [ "$in_str" = "1" ]; then
      if [ "$esc" = "1" ]; then esc=0
      elif [ "$ch" = "\\" ]; then esc=1
      elif [ "$ch" = '"' ]; then in_str=0
      fi
    elif [ "$ch" = '"' ]; then in_str=1
    elif [ "$ch" = "{" ] && [ "$oi" -lt 0 ]; then oi=$i
    elif [ "$ch" = "}" ]; then ci=$i
    fi
  done
  [ "$oi" -ge 0 ] && [ "$ci" -ge "$oi" ] || return 1
  head="${line:0:oi+1}"; tail="${line:ci+1}"
  LINES_BUF[open]="$head"
  _lines_splice_in $((open+1)) "$(_json_indent "$level")}$tail"
  return 0
}

# Insert `"key": {}` as the last member of the object path arguments.
_json_insert_object() {
  local key="$1"; shift
  local parent=("$@")
  _json_object_range "${parent[@]}" || return 1
  if [ "$JR_OPEN" = "$JR_CLOSE" ]; then
    _json_expand_empty_object "$JR_OPEN" "$JR_CLOSE" "$((JR_DEPTH-1))" || return 1
    _json_object_range "${parent[@]}" || return 1
  fi
  _json_ensure_comma "$JR_START" "$JR_END"
  local level="$JR_DEPTH" member_indent
  member_indent=$(_json_indent "$level")
  _lines_splice_in "$JR_END" "${member_indent}\"$key\": {" "${member_indent}}"
}

_json_ensure_object() {
  local path=("$@") n=$# i
  _json_object_range "${path[@]}" && return 0
  if [ "$n" -eq 0 ]; then
    LINES_BUF=("{" "}")
    return 0
  fi
  local parent=()
  for ((i=0; i<n-1; i++)); do parent[${#parent[@]}]="${path[i]}"; done
  _json_ensure_object "${parent[@]}" || return 1
  _json_insert_object "${path[n-1]}" "${parent[@]}"
}

# Read a scalar member. $1 is the member key, remaining args are its object path.
_json_read_key() {
  local key="$1"; shift
  local parent=("$@") i
  _json_object_range "${parent[@]}" || return 1
  for ((i=JR_START; i<JR_END; i++)); do
    [ "${JD_START[i]}" = "$JR_DEPTH" ] || continue
    if [[ "${LINES_BUF[i]}" =~ ^[[:space:]]*\"$key\"[[:space:]]*:[[:space:]]*(.*[^[:space:]])[[:space:]]*,?[[:space:]]*$ ]]; then
      local val="${BASH_REMATCH[1]}"
      val="${val%,}"
      val="${val%"${val##*[![:space:]]}"}"
      printf '%s' "$val"
      return 0
    fi
  done
  return 1
}

# Set a scalar member. $1 is the raw JSON value, $2 the member key, remaining
# args are the object path.
_json_set_key() {
  local value="$1" key="$2"; shift 2
  local parent=("$@") i
  _json_ensure_object "${parent[@]}" || return 1
  _json_object_range "${parent[@]}" || return 1
  local member_indent; member_indent=$(_json_indent "$JR_DEPTH")
  for ((i=JR_START; i<JR_END; i++)); do
    [ "${JD_START[i]}" = "$JR_DEPTH" ] || continue
    if [[ "${LINES_BUF[i]}" =~ ^([[:space:]]*\"$key\"[[:space:]]*:[[:space:]]*)(.*)[[:space:]]*$ ]]; then
      local prefix="${BASH_REMATCH[1]}" rest="${BASH_REMATCH[2]}" comma=""
      if [[ "$rest" == *, ]]; then comma=","; rest="${rest%,}"; fi
      LINES_BUF[i]="${prefix}${value}${comma}"
      return 0
    fi
  done
  if [ "$JR_OPEN" = "$JR_CLOSE" ]; then
    _json_expand_empty_object "$JR_OPEN" "$JR_CLOSE" "$((JR_DEPTH-1))" || return 1
    _json_object_range "${parent[@]}" || return 1
    member_indent=$(_json_indent "$JR_DEPTH")
  fi
  _json_ensure_comma "$JR_START" "$JR_END"
  _lines_splice_in "$JR_END" "${member_indent}\"$key\": $value"
}

# Remove a member. $1 is the member key, remaining args are its object path.
_json_remove_key() {
  local key="$1"; shift
  local parent=("$@") i
  _json_object_range "${parent[@]}" || return 1
  local idx=-1
  for ((i=JR_START; i<JR_END; i++)); do
    [ "${JD_START[i]}" = "$JR_DEPTH" ] || continue
    if [[ "${LINES_BUF[i]}" =~ ^[[:space:]]*\"$key\"[[:space:]]*: ]]; then idx=$i; break; fi
  done
  [ "$idx" -ge 0 ] || return 1
  _lines_splice_out "$idx" 1
  _json_depth_maps
  _json_object_range "${parent[@]}" || return 0
  local has_later=0
  for ((i=idx; i<JR_END; i++)); do
    if [ "${JD_START[i]}" = "$JR_DEPTH" ]; then has_later=1; break; fi
  done
  if [ "$has_later" = "0" ] && _json_last_content_line "$JR_START" "$JR_END"; then
    LINES_BUF[JLC]="${LINES_BUF[JLC]%,}"
  fi
  return 0
}

# ---------- atomic write ----------

write_atomic() {
  # Write stdin to $1 atomically; create one-shot $1.bak from the existing
  # file. On failure, prepend `pmsec: write_atomic <step>` so orchestrator
  # logs reveal which step (mkdir/cp/mktemp/write/mv) blew up. The lower
  # command's own stderr is preserved alongside.
  local path="$1" dir tmp bak mode top_created=""
  dir=$(dirname -- "$path")
  if [ ! -d "$dir" ]; then
    # Walk up while parents are missing so chown later only touches the
    # ancestors we actually created — never an existing user-owned dir.
    local home_dir; home_dir=$(_pmsec_home)
    top_created="$dir"
    while [ -n "$top_created" ] && [ "$top_created" != "/" ] && [ "$top_created" != "$home_dir" ] \
          && [ ! -d "$(dirname -- "$top_created")" ]; do
      top_created=$(dirname -- "$top_created")
    done
    if ! mkdir -p -- "$dir"; then
      printf 'pmsec: write_atomic mkdir failed for %s\n' "$dir" >&2
      return 1
    fi
  fi
  if [ -L "$path" ]; then
    printf 'pmsec: refusing to write through symlink %s\n' "$path" >&2
    return 1
  fi
  bak="$path.bak"
  # `-e` follows links, so a dangling symlink planted at the backup path looks
  # absent; `cp` would then create the file wherever the link points.
  if [ -L "$bak" ]; then
    printf 'pmsec: refusing to write backup through symlink %s\n' "$bak" >&2
    return 1
  fi
  _pmsec_root_dir_guard "$dir" || return 1
  if [ -e "$path" ] && [ ! -e "$bak" ]; then
    if ! cp -p -- "$path" "$bak"; then
      printf 'pmsec: write_atomic backup-copy failed for %s\n' "$bak" >&2
      return 1
    fi
  fi
  if ! tmp=$(mktemp "$path.XXXXXX"); then
    printf 'pmsec: write_atomic mktemp failed in %s\n' "$dir" >&2
    return 1
  fi
  if ! cat > "$tmp"; then
    printf 'pmsec: write_atomic body-write failed for %s\n' "$tmp" >&2
    rm -f -- "$tmp"
    return 1
  fi
  if [ -e "$path" ]; then
    # An existing .npmrc / .yarnrc may carry a registry token under 600.
    mode=$(_pmsec_stat '%Lp' '%a' "$path")
    [ -n "$mode" ] && chmod "$mode" "$tmp" 2>/dev/null || true
  elif [ "$(id -u)" = "0" ]; then
    # mktemp creates 600; under root that would be unreadable post-chown.
    chmod 644 "$tmp" 2>/dev/null || true
  fi
  if ! mv -f -- "$tmp" "$path"; then
    printf 'pmsec: write_atomic rename failed for %s\n' "$path" >&2
    rm -f -- "$tmp"
    return 1
  fi
  _pmsec_handback "$path" "$bak" "$top_created"
}

# Under root, a user-planted symlinked directory (`~/.config -> /etc`) would
# make mkdir/cp/mv above act on the link target. Refuse when a path that is
# lexically inside the target home resolves physically outside it. Paths that
# are already outside the home (operator-set CARGO_HOME etc.) are the
# operator's choice and pass through unchanged.
_pmsec_root_dir_guard() {
  [ "$(id -u)" = "0" ] || return 0
  local dir="$1" home_dir home_phys dir_phys
  home_dir=$(_pmsec_home)
  case "$dir" in
    "$home_dir"|"$home_dir"/*) ;;
    *) return 0 ;;
  esac
  home_phys=$(cd -P -- "$home_dir" 2>/dev/null && pwd -P) || return 0
  # The leaf may not exist yet (mkdir -p creates it below); resolve the
  # deepest existing ancestor, since that is where mkdir would follow a link.
  local probe="$dir"
  while [ ! -d "$probe" ] && [ "$probe" != "/" ] && [ "$probe" != "$home_dir" ]; do
    probe=$(dirname -- "$probe")
  done
  dir_phys=$(cd -P -- "$probe" 2>/dev/null && pwd -P) || return 0
  case "$dir_phys" in
    "$home_phys"|"$home_phys"/*) return 0 ;;
  esac
  printf 'pmsec: refusing to write under %s: it resolves to %s, outside %s\n' "$dir" "$dir_phys" "$home_phys" >&2
  return 1
}

# Hand the freshly-written file (and dirs we created) back to the home owner
# when running as root. Caller must always invoke; the function decides.
#
# When chown fails (SIP, SELinux, TCC, mounted volume that doesn't honor
# ownership) we WARN to stderr instead of swallowing — silent chown failure
# was the worst unattended-deployment bug to debug, since enable would
# report success but leave a root-owned file the user can't read or modify.
# Exit code stays 0 because the bundle is in place; the warning tells the
# operator to fix ownership manually.
_pmsec_handback() {
  [ "$(id -u)" = "0" ] || return 0
  local path="$1" bak="$2" top_created="$3"
  local owner; owner=$(_pmsec_owner_of "$(_pmsec_home)")
  [ -n "$owner" ] || return 0
  local err
  # `-h` never follows a link, so even a link swapped in after our own
  # checks cannot redirect a root chown at a file outside the user's home.
  if ! err=$(chown -h "$owner" "$path" 2>&1); then
    printf 'pmsec: warning: chown %s %s failed (%s); file may be unreadable for the user\n' \
      "$owner" "$path" "$err" >&2
  fi
  if [ -e "$bak" ]; then
    if ! err=$(chown -h "$owner" "$bak" 2>&1); then
      printf 'pmsec: warning: chown %s %s failed (%s)\n' "$owner" "$bak" "$err" >&2
    fi
  fi
  if [ -n "$top_created" ] && [ -d "$top_created" ]; then
    if ! err=$(chown -R "$owner" "$top_created" 2>&1); then
      printf 'pmsec: warning: chown -R %s %s failed (%s)\n' "$owner" "$top_created" "$err" >&2
    fi
  fi
  return 0
}

# ---------- version detection ----------

# Echo "MAJOR MINOR PATCH RAW" (space separated). Return 1 if not detected.
# `version_override_env_var <bin>` resolves to an env var name (e.g.
# `PMSEC_PNPM_VERSION`) — when set, its value short-circuits real detection so
# tests can deterministically simulate pnpm 11 (or hide pnpm with "none")
# regardless of what's installed locally.
version_override_env_var() {
  case "$1" in
    npm)   printf 'PMSEC_NPM_VERSION' ;;
    pnpm)  printf 'PMSEC_PNPM_VERSION' ;;
    yarn)  printf 'PMSEC_YARN_VERSION' ;;
    bun)   printf 'PMSEC_BUN_VERSION' ;;
    cargo) printf 'PMSEC_CARGO_VERSION' ;;
    mise)  printf 'PMSEC_MISE_VERSION' ;;
    uv)    printf 'PMSEC_UV_VERSION' ;;
    bundler) printf 'PMSEC_BUNDLER_VERSION' ;;
    aube)  printf 'PMSEC_AUBE_VERSION' ;;
    composer) printf 'PMSEC_COMPOSER_VERSION' ;;
    *)     printf '' ;;
  esac
}

version_detect() {
  local bin="$1" out var ovr
  var=$(version_override_env_var "$bin")
  if [ -n "$var" ]; then
    ovr="${!var-}"
    if [ "$ovr" = "none" ]; then return 1; fi
    if [ -n "$ovr" ]; then
      if [[ "$ovr" =~ ([0-9]+)\.([0-9]+)\.([0-9]+) ]]; then
        printf '%s %s %s %s' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[0]}"
        return 0
      fi
    fi
  fi
  command -v "$bin" >/dev/null 2>&1 || return 1
  out=$("$bin" --version 2>/dev/null) || return 1
  if [[ "$out" =~ ([0-9]+)\.([0-9]+)\.([0-9]+) ]]; then
    printf '%s %s %s %s' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[0]}"
    return 0
  fi
  return 1
}

# version_gte VA VB VC TA TB TC — return 0 if (VA,VB,VC) >= (TA,TB,TC).
version_gte() {
  if [ "$1" -ne "$4" ]; then [ "$1" -gt "$4" ]; return; fi
  if [ "$2" -ne "$5" ]; then [ "$2" -gt "$5" ]; return; fi
  [ "$3" -ge "$6" ]
}

