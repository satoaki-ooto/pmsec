      printf 'dangerouslyAllowAllBuilds|false|dangerouslyAllowAllBuilds: false|:||\n'
      printf 'trustLockfile|false|trustLockfile: false|:||\n'
      printf 'minimumReleaseAgeIgnoreMissingTime|false|minimumReleaseAgeIgnoreMissingTime: false|:||\n'
      ;;
    *) ;;
  esac
}

# ---------- per-tool: read (configured value + days) ----------
# Echoes "configured|days" (configured may contain anything, days is integer or
# empty when unparseable). Return 1 if the key is absent.

# parse "Nd" / "Nw" / "Ndays" / "Nweeks" (optionally surrounded by quotes).
# Pass `extra_units=1` to also accept m/months and y/years (used by mise).
parse_days_dw() {
  local v="$1" extra="${2:-0}" n unit lc
  v="${v#\"}"; v="${v%\"}"
  v="${v#"${v%%[![:space:]]*}"}"
  v="${v%"${v##*[![:space:]]}"}"
  [[ "$v" =~ ^([0-9]+)[[:space:]]*([A-Za-z]+)$ ]] || return 1
  n="${BASH_REMATCH[1]}"; unit="${BASH_REMATCH[2]}"
  lc=$(printf '%s' "$unit" | tr '[:upper:]' '[:lower:]')
  case "$lc" in
    d|day|days) printf '%d' "$n" ;;
    w|week|weeks) printf '%d' "$((n*7))" ;;
    m|month|months) [ "$extra" = 1 ] && printf '%d' "$((n*30))" || return 1 ;;
    y|year|years)   [ "$extra" = 1 ] && printf '%d' "$((n*365))" || return 1 ;;
    *) return 1 ;;
  esac
}

# mise additionally accepts months/years.
parse_days_mise() { parse_days_dw "$1" 1; }

# ---------- mise: mode, miserc env selector, generations ----------

MISE_MIGRATION_WARN='a previous new-style mise configuration exists (config.pmsec.toml or the pmsec miserc selector); run `pmsec` to consolidate it'
MISE_ENV_WARN='MISE_ENV overrides miserc and the pmsec environment is not active in this shell'

# supportsNewMode = detected mise >= 2026.11.0 AND no MISE_GLOBAL_CONFIG_FILE.
mise_supports_new_mode() {
  [ -z "${MISE_GLOBAL_CONFIG_FILE:-}" ] || return 1
  local v; v=$(version_detect mise) || return 1
  set -- $v
  version_gte "$1" "$2" "$3" 2026 11 0
}

mise_has_new_artifacts() {
  # A leftover config.pmsec.toml that defines no managed keys and is not
  # selected anywhere is inert — mise loads the layer only when the pmsec
  # environment is active — so legacy mode must converge instead of failing
  # forever on a file the cleanup intentionally keeps. An artifact is an
  # active selector (MISE_ENV or the effective miserc) or managed keys in the
  # file. Only the first miserc that defines env counts: a pmsec name in a
  # lower-precedence miserc is shadowed and never selects the layer. A parsed
  # nonempty MISE_ENV (entries trimmed, empties dropped) replaces the miserc
  # list entirely, so the miserc files are not scanned when it names any
  # environment; MISE_ENV="," selects nothing and must not hide the artifact.
  local p v override=0
  if mise_env_override; then
    override=1
    while IFS= read -r v; do
      [ "$v" = "pmsec" ] && return 0
    done < <(mise_env_list "$MISE_ENV")
  fi
  if [ "$override" = "0" ]; then
    for p in "$(path_mise_local_miserc)" "$(path_mise_shared_miserc)" "$(path_mise_system_miserc)"; do
      [ -e "$p" ] || continue
      # Status 2: an unreadable selector may still activate pmsec.
      if [ ! -r "$p" ]; then
        printf 'cannot read %s\n' "$p" >&2
        return 2
      fi
      lines_load "$p"
      miserc_parse_env || continue
      [ "$MISE_ENVDEF" = "1" ] || continue
      for v in "${MISE_ENV_VALUES[@]}"; do
        [ "$v" = "pmsec" ] && return 0
      done
      break
    done
  fi
  local pmsecp; pmsecp=$(path_mise_pmsec)
  [ -e "$pmsecp" ] || return 1
  # An unreadable pmsec file may hold managed keys: status 2 so a legacy
  # check cannot report OK from a file it could not inspect.
  if [ ! -r "$pmsecp" ]; then
    printf 'cannot read %s\n' "$pmsecp" >&2
    return 2
  fi
  # An aliased pmsec file is the legacy destination itself, not a leftover.
  mise_alias_state "$(path_mise)" "$pmsecp"
  [ "$MISE_ALIAS_STATE" = "aliased" ] && return 1
  lines_load "$pmsecp"
  lines_read_key "minimum_release_age" "=" "settings" >/dev/null && return 0
  local ek ev el es esec esafe
  while IFS='|' read -r ek ev el es esec esafe; do
    [ -z "$ek" ] && continue
    lines_read_key "$ek" "$es" "$esec" >/dev/null && return 0
  done < <(tool_extras mise)
  return 1
}

# Parse the top-level `env = [...]` assignment currently in LINES_BUF.
# "Top-level" also excludes TOML multi-line strings: text inside a `"""`
# body is never taken for the selector. Scan against SCAN_BUF, parse the
# array from the raw lines.
# Sets MISE_ENVDEF=1, MISE_ENV_START/END (line indexes), and MISE_ENV_VALUES.
# Returns 0 when defined, 1 when absent/not top-level, 2 when invalid.
MISERC_J=0; MISERC_K=0; MISERC_CH=""; MISERC_ERR='miserc env must be an array'
_miserc_skip() {
  local line ch
  while :; do
    if [ "$MISERC_J" -ge "${#LINES_BUF[@]}" ]; then MISERC_ERR='miserc env array is unterminated'; MISERC_CH=""; return 1; fi
    line="${LINES_BUF[MISERC_J]}"
    if [ "$MISERC_K" -ge "${#line}" ]; then MISERC_J=$((MISERC_J+1)); MISERC_K=0; continue; fi
    ch="${line:MISERC_K:1}"
    if [ "$ch" = "#" ]; then MISERC_J=$((MISERC_J+1)); MISERC_K=0; continue; fi
    if [[ "$ch" =~ [[:space:]] ]]; then MISERC_K=$((MISERC_K+1)); continue; fi
    MISERC_CH="$ch"; return 0
  done
}

# Set _MISERC_UTF8 to the UTF-8 encoding of a codepoint. printf %b expands
# the octal escapes; bash cannot hold NUL, so codepoint 0 contributes
# nothing. printf -v (not command substitution) so a codepoint whose encoding
# is a newline survives.
_miserc_utf8() {
  local cp="$1" esc
  if [ "$cp" -lt 128 ]; then
    esc=$(printf '\\%03o' "$cp")
  elif [ "$cp" -lt 2048 ]; then
    esc=$(printf '\\%03o\\%03o' "$(( (cp >> 6) | 192 ))" "$(( (cp & 63) | 128 ))")
  elif [ "$cp" -lt 65536 ]; then
    esc=$(printf '\\%03o\\%03o\\%03o' "$(( (cp >> 12) | 224 ))" "$(( ((cp >> 6) & 63) | 128 ))" "$(( (cp & 63) | 128 ))")
  else
    esc=$(printf '\\%03o\\%03o\\%03o\\%03o' "$(( (cp >> 18) | 240 ))" "$(( ((cp >> 12) & 63) | 128 ))" "$(( ((cp >> 6) & 63) | 128 ))" "$(( (cp & 63) | 128 ))")
  fi
  printf -v _MISERC_UTF8 '%b' "$esc"
}

# Decode one TOML basic-string escape into _MISERC_DECODED (a global: command
# substitution would strip a decoded trailing newline, e.g. \n or \u000a).
# $1 = escape char, $2 = hex digits (for \u/\U). Invalid hex contributes
# nothing, matching the node/python decoders.
_miserc_decode_escape() {
  local ch="$1" hex="$2" w=4
  _MISERC_DECODED=""
  case "$ch" in
    [uU])
      [ "$ch" = "U" ] && w=8
      if [ "${#hex}" = "$w" ] && [[ "$hex" =~ ^[0-9A-Fa-f]+$ ]]; then
        _miserc_utf8 $((16#$hex))
        _MISERC_DECODED="$_MISERC_UTF8"
      fi
      return 0 ;;
    b) _MISERC_DECODED=$'\b' ;;
    t) _MISERC_DECODED=$'\t' ;;
    n) _MISERC_DECODED=$'\n' ;;
    f) _MISERC_DECODED=$'\f' ;;
    r) _MISERC_DECODED=$'\r' ;;
    *) _MISERC_DECODED="$ch" ;;
  esac
}

# Decode a complete TOML basic-string body (no surrounding quotes), so an
# escaped quoted key ("e\u006ev") compares equal to the bare env key.
_miserc_decode_basic() {
  # `${#s}` in the same `local` command expands before s is assigned, so n
  # must be declared in a second statement.
  local s="$1"
  local out="" i=0 n=${#s} c
  while (( i < n )); do
    c="${s:i:1}"
    if [ "$c" = "\\" ]; then
      i=$((i+1))
      if (( i >= n )); then out+="$c"; break; fi
      c="${s:i:1}"
      if [ "$c" = "u" ] || [ "$c" = "U" ]; then
        local w=4 hex
        [ "$c" = "U" ] && w=8
        hex="${s:$((i+1)):$w}"
        i=$((i+1+w))
        _miserc_decode_escape "$c" "$hex"
        out+="$_MISERC_DECODED"
      else
        _miserc_decode_escape "$c" ""
        out+="$_MISERC_DECODED"
        i=$((i+1))
      fi
      continue
    fi
    out+="$c"; i=$((i+1))
  done
  printf '%s' "$out"
}

_miserc_parse_array() {
  local line ch quote val closed need_sep=0 ml=0 closing
  _miserc_skip || return 1
  [ "$MISERC_CH" = "[" ] || { MISERC_ERR='miserc env must be an array'; return 1; }
  MISERC_K=$((MISERC_K+1))
  while :; do
    _miserc_skip || return 1
    case "$MISERC_CH" in
      "]") MISERC_K=$((MISERC_K+1)); break ;;
      ",")
        # A comma is required between values; none may lead or repeat (a
        # trailing comma stays valid TOML).
        [ "$need_sep" = "1" ] || { MISERC_ERR='miserc env has an unexpected comma'; return 1; }
        need_sep=0; MISERC_K=$((MISERC_K+1)); continue ;;
      '"'|"'")
        [ "$need_sep" = "0" ] || { MISERC_ERR='miserc env is missing a comma between names'; return 1; }
        quote="$MISERC_CH"; MISERC_K=$((MISERC_K+1))
        # A multiline string opener (""" or ''') makes one value that may span
        # lines: `env = ["""work"""]` is valid TOML.
        line="${LINES_BUF[MISERC_J]}"
        if [ "${line:MISERC_K:2}" = "$quote$quote" ]; then
          MISERC_K=$((MISERC_K+2)); ml=1
        else
          ml=0
        fi ;;
      *) MISERC_ERR='miserc env may only contain string names'; return 1 ;;
    esac
    if [ "$ml" = "1" ]; then
      # TOML trims the first newline right after the opening delimiter.
      line="${LINES_BUF[MISERC_J]}"
      if [ "$MISERC_K" -ge "${#line}" ]; then MISERC_J=$((MISERC_J+1)); MISERC_K=0; fi
      val=""; closed=0
      while [ "$MISERC_J" -lt "${#LINES_BUF[@]}" ]; do
        line="${LINES_BUF[MISERC_J]}"
        if [ "$MISERC_K" -ge "${#line}" ]; then
          MISERC_J=$((MISERC_J+1)); MISERC_K=0
          val+=$'\n'
          continue
        fi
        ch="${line:MISERC_K:1}"
        if [ "$quote" = '"' ] && [ "$ch" = "\\" ]; then
          # A backslash before the end of the line (spaces and tabs allowed)
          # trims the newline and the following whitespace; other escapes
          # decode like the single-line path.
          if [[ "${line:$((MISERC_K+1))}" =~ ^[[:space:]]*$ ]]; then
            MISERC_J=$((MISERC_J+1)); MISERC_K=0
            while [ "$MISERC_J" -lt "${#LINES_BUF[@]}" ]; do
              line="${LINES_BUF[MISERC_J]}"
              ch="${line#"${line%%[![:space:]]*}"}"
              if [ -z "$ch" ]; then MISERC_J=$((MISERC_J+1)); continue; fi
              MISERC_K=$(( ${#line} - ${#ch} ))
              break
            done
            continue
          fi
          MISERC_K=$((MISERC_K+1))
          if [ "$MISERC_K" -ge "${#line}" ]; then MISERC_ERR='miserc env has an unterminated escape'; return 1; fi
          ch="${line:MISERC_K:1}"
          if [ "$ch" = "u" ] || [ "$ch" = "U" ]; then
            local w=4 hex
            [ "$ch" = "U" ] && w=8
            hex="${line:$((MISERC_K+1)):$w}"
            MISERC_K=$((MISERC_K+1+w))
            _miserc_decode_escape "$ch" "$hex"
            val+="$_MISERC_DECODED"
          else
            _miserc_decode_escape "$ch" ""
            val+="$_MISERC_DECODED"
            MISERC_K=$((MISERC_K+1))
          fi
          continue
        fi
        # One or two content quotes may precede the closing delimiter, so a
        # four-/five-quote run closes on its final three quotes.
        closing=0
        while [ "${line:$((MISERC_K+closing)):1}" = "$quote" ]; do
          closing=$((closing+1))
          [ "$closing" -lt "5" ] || break
        done
        if [ "$closing" = "4" ] || [ "$closing" = "5" ]; then
          val+="$quote"; [ "$closing" = "5" ] && val+="$quote"
          MISERC_K=$((MISERC_K+closing)); closed=1; break
        fi
        if [ "$closing" = "3" ]; then
          MISERC_K=$((MISERC_K+3)); closed=1; break
        fi
        val+="$ch"; MISERC_K=$((MISERC_K+1))
      done
      [ "$closed" = "1" ] || { MISERC_ERR='miserc env has an unterminated string'; return 1; }
      MISE_ENV_VALUES[${#MISE_ENV_VALUES[@]}]="$val"
      need_sep=1
      continue
    fi
    val=""; closed=0
    while [ "$MISERC_J" -lt "${#LINES_BUF[@]}" ]; do
      line="${LINES_BUF[MISERC_J]}"
      if [ "$MISERC_K" -ge "${#line}" ]; then MISERC_J=$((MISERC_J+1)); MISERC_K=0; continue; fi
      ch="${line:MISERC_K:1}"
      if [ "$quote" = '"' ] && [ "$ch" = "\\" ]; then
        # Decode TOML basic-string escapes so an escaped env name survives
        # enable unchanged; invalid hex contributes nothing, matching the
        # node/python decoders.
        MISERC_K=$((MISERC_K+1))
        if [ "$MISERC_K" -ge "${#line}" ]; then MISERC_ERR='miserc env has an unterminated escape'; return 1; fi
        ch="${line:MISERC_K:1}"
        if [ "$ch" = "u" ] || [ "$ch" = "U" ]; then
          local w=4 hex
          [ "$ch" = "U" ] && w=8
          hex="${line:$((MISERC_K+1)):$w}"
          MISERC_K=$((MISERC_K+1+w))
          _miserc_decode_escape "$ch" "$hex"
          val+="$_MISERC_DECODED"
        else
          _miserc_decode_escape "$ch" ""
          val+="$_MISERC_DECODED"
          MISERC_K=$((MISERC_K+1))
        fi
        continue
      fi
      if [ "$ch" = "$quote" ]; then MISERC_K=$((MISERC_K+1)); closed=1; break; fi
      val+="$ch"; MISERC_K=$((MISERC_K+1))
    done
    [ "$closed" = "1" ] || { MISERC_ERR='miserc env has an unterminated string'; return 1; }
    MISE_ENV_VALUES[${#MISE_ENV_VALUES[@]}]="$val"
    need_sep=1
  done
  MISE_ENV_END="$MISERC_J"
  return 0
}

miserc_parse_env() {
  MISE_ENVDEF=0; MISE_ENV_START=-1; MISE_ENV_END=-1; MISE_ENV_VALUES=()
  # TOML treats "env", 'env', and env as the same key; recognize all three so
  # migration replaces the existing assignment instead of adding a duplicate.
  # A basic-quoted key may carry escapes ("e\u006ev" decodes to env), so the
  # quoted spellings are captured and decoded before the comparison.
  local env_key_re="^[[:space:]]*(\"[^\"]*\"|'[^']*'|env)[[:space:]]*="
  lines_scan
  local n=${#LINES_BUF[@]} i line prefix rawkey key
  for ((i=0; i<n; i++)); do
    lines_is_section "${SCAN_BUF[i]}" && break
    [[ "${SCAN_BUF[i]}" =~ $env_key_re ]] || continue
    rawkey="${BASH_REMATCH[1]}"
    if [[ "$rawkey" == \"*\" ]]; then
      # `$( )` strips trailing newlines; a sentinel keeps a decoded key like
      # "env\n" distinct from the bare env key.
      key=$(_miserc_decode_basic "${rawkey:1:${#rawkey}-2}"; printf x)
      key="${key%x}"
    elif [[ "$rawkey" == \'*\' ]]; then
      key="${rawkey:1:${#rawkey}-2}"
    else
      key="$rawkey"
    fi
    [ "$key" = "env" ] || continue
    line="${LINES_BUF[i]}"; prefix="${line%%=*}"
    MISE_ENV_START="$i"
    MISERC_J="$i"; MISERC_K=$((${#prefix}+1))
    _miserc_parse_array || return 2
    MISE_ENVDEF=1
    return 0
  done
  return 1
}

# Quote a value for a TOML basic string: escape backslash and quote, then
# every control character TOML forbids (C0 short escapes where TOML defines
# them, the rest and DEL as \uXXXX). Non-ASCII stays raw.
miserc_quote() {
  local s="$1" out="" i c ord
  for ((i=0; i<${#s}; i++)); do
    c="${s:i:1}"
    case "$c" in
      # A quoted backslash inside a case pattern is a literal character, so
      # "\\" here would match two backslashes; "\\\\" is the one-char pattern.
      "\\") out+='\\' ;;
      '"') out+='\"' ;;
      $'\b') out+='\b' ;;
      $'\t') out+='\t' ;;
      $'\n') out+='\n' ;;
      $'\f') out+='\f' ;;
      $'\r') out+='\r' ;;
      *)
        ord=$(printf '%d' "'$c")
        if [ "$ord" -lt 32 ] || [ "$ord" -eq 127 ]; then
          out+=$(printf '\\u%04x' "$ord")
        else
          out+="$c"
        fi
        ;;
    esac
  done
  printf '"%s"' "$out"
}

# Replace/insert the top-level env assignment in LINES_BUF with the given names.
miserc_set_env_values() {
  local line="env = [" v first=1 idx
  for v in "$@"; do
    [ "$first" = "1" ] || line+=", "
    first=0; line+="$(miserc_quote "$v")"
  done
  line+="]"
  if [ "$MISE_ENVDEF" = "1" ]; then
    _lines_splice_out "$MISE_ENV_START" $((MISE_ENV_END - MISE_ENV_START + 1))
    _lines_splice_in "$MISE_ENV_START" "$line"
    return 0
  fi
  lines_scan
  idx=$(lines_first_section_idx)
  if [ "$idx" = "-1" ]; then
    LINES_BUF[${#LINES_BUF[@]}]="$line"
  elif [ "$idx" -gt 0 ] && [ -z "${LINES_BUF[idx-1]}" ]; then
    _lines_splice_in $((idx-1)) "$line"
  else
    _lines_splice_in "$idx" "$line"
  fi
}

# Remove $1 (pmsec) from the env assignment in LINES_BUF. Returns 0 if changed.
miserc_remove_env_value() {
  local name="$1" v line kept=() changed=0
  [ "$MISE_ENVDEF" = "1" ] || return 1
  for v in "${MISE_ENV_VALUES[@]}"; do
    if [ "$v" = "$name" ]; then changed=1; else kept[${#kept[@]}]="$v"; fi
  done
  [ "$changed" = "1" ] || return 1
  if [ "${#kept[@]}" -eq 0 ]; then
    _lines_splice_out "$MISE_ENV_START" $((MISE_ENV_END - MISE_ENV_START + 1))
    return 0
  fi
  # Rebuild in place (MISE_ENVDEF still points at the original assignment).
  line="env = ["; local first=1
  for v in "${kept[@]}"; do
    [ "$first" = "1" ] || line+=", "
    first=0; line+="$(miserc_quote "$v")"
  done
  line+="]"
  _lines_splice_out "$MISE_ENV_START" $((MISE_ENV_END - MISE_ENV_START + 1))
  _lines_splice_in "$MISE_ENV_START" "$line"
  return 0
}

_miserc_buf_empty() {
  local l
  for l in "${LINES_BUF[@]}"; do [ -n "${l//[[:space:]]/}" ] && return 1; done
  return 0
}

# Load the first miserc file (local -> shared -> system) that defines env into
# MISE_BASE_ENV_VALUES. Invalid env fails before any write. MISE_BASE_ENV_PATH
# records which file owned the list so selector cleanup can tell a local
# assignment from an inherited one.
MISE_BASE_ENV_PATH=""
mise_inherited_env() {
  local p r i
  MISE_BASE_ENV_VALUES=(); MISE_BASE_ENV_PATH=""
  for p in "$(path_mise_local_miserc)" "$(path_mise_shared_miserc)" "$(path_mise_system_miserc)"; do
    [ -e "$p" ] || continue
    # An unreadable miserc cannot prove which environments it selects; treat
    # it like a parse failure instead of judging as if it were empty.
    if [ ! -r "$p" ]; then
      MISERC_ERR="cannot read $p"
      printf '%s\n' "$MISERC_ERR" >&2
      return 1
    fi
    lines_load "$p" || { MISERC_ERR="cannot read $p"; printf '%s\n' "$MISERC_ERR" >&2; return 1; }
    miserc_parse_env; r=$?
    if [ "$r" = "2" ]; then
      printf '%s\n' "$MISERC_ERR" >&2
      return 1
    fi
    [ "$r" = "0" ] || continue
    for ((i=0; i<${#MISE_ENV_VALUES[@]}; i++)); do MISE_BASE_ENV_VALUES[i]="${MISE_ENV_VALUES[i]}"; done
    MISE_BASE_ENV_PATH="$p"
    return 0
  done
  return 0
}

# True when a nonempty MISE_ENV list (after trimming) replaces the miserc list.
mise_env_override() {
  local e
  while IFS= read -r e; do return 0; done < <(mise_env_list "${MISE_ENV:-}")
  return 1
}

mise_env_list() {
  # Trim each entry and drop empties, matching the node/python envListFrom —
  # "work, pmsec" must select pmsec, not " pmsec".
  local IFS=',' raw e
  set -f
  set -- $1
  set +f
  for raw in "$@"; do
    e="${raw#"${raw%%[![:space:]]*}"}"
    e="${e%"${e##*[![:space:]]}"}"
    [ -n "$e" ] && printf '%s\n' "$e"
  done
  return 0
}

mise_env_warning() {
  local e v
  # Only a parsed nonempty MISE_ENV replaces the miserc list; MISE_ENV=","
  # leaves the files in charge, so the shell still sees the pmsec layer.
  mise_env_override || return 0
  while IFS= read -r e; do
    [ "$e" = "pmsec" ] && return 0
  done < <(mise_env_list "$MISE_ENV")
  printf '%s' "$MISE_ENV_WARN"
}

MISE_SELECTOR_PATH=""; MISE_SELECTOR_WIRED=0; MISE_SELECTOR_VALUES=()
mise_selector_state() {
  local p r i e n
  MISE_SELECTOR_PATH=""; MISE_SELECTOR_WIRED=0; MISE_SELECTOR_VALUES=()
  # pmsec is only the effective layer when it loads last: later environments
  # override earlier ones, so membership alone cannot prove the hardened
  # values win. Only a parsed nonempty MISE_ENV replaces the miserc list;
  # MISE_ENV="," selects nothing and leaves the files in charge.
  if mise_env_override; then
    MISE_SELECTOR_PATH="MISE_ENV"
    while IFS= read -r e; do
      MISE_SELECTOR_VALUES[${#MISE_SELECTOR_VALUES[@]}]="$e"
    done < <(mise_env_list "$MISE_ENV")
    n=${#MISE_SELECTOR_VALUES[@]}
    [ "$n" -gt 0 ] && [ "${MISE_SELECTOR_VALUES[$((n-1))]}" = "pmsec" ] && MISE_SELECTOR_WIRED=1
    return 0
  fi
  for p in "$(path_mise_local_miserc)" "$(path_mise_shared_miserc)" "$(path_mise_system_miserc)"; do
    [ -e "$p" ] || continue
    # An unreadable selector may still activate pmsec: report it (status 2,
    # MISERC_ERR for the caller to print) instead of judging from thin air.
    if [ ! -r "$p" ]; then
      MISERC_ERR="cannot read $p"
      return 2
    fi
    lines_load "$p" || { MISERC_ERR="cannot read $p"; return 2; }
    miserc_parse_env; r=$?
    [ "$r" = "2" ] && return 2
    [ "$r" = "0" ] || continue
    MISE_SELECTOR_PATH="$p"
    for ((i=0; i<${#MISE_ENV_VALUES[@]}; i++)); do
      MISE_SELECTOR_VALUES[i]="${MISE_ENV_VALUES[i]}"
    done
    n=${#MISE_SELECTOR_VALUES[@]}
    [ "$n" -gt 0 ] && [ "${MISE_SELECTOR_VALUES[$((n-1))]}" = "pmsec" ] && MISE_SELECTOR_WIRED=1
    return 0
  done
  MISE_SELECTOR_PATH="$(path_mise_local_miserc)"
  return 0
}

mise_read_merged() {
  local p q dup val d best=-1 bestval="" fallback=""
  MISE_READ_FILES=()
  for p in "$@"; do
    dup=0
    for q in "${MISE_READ_FILES[@]}"; do [ "$q" = "$p" ] && dup=1; done
    [ "$dup" = "1" ] && continue
    MISE_READ_FILES[${#MISE_READ_FILES[@]}]="$p"
    # A layer that cannot be read may hold a stricter cooldown: an unreadable
    # 30-day config.work.toml must not let the enable write 1 day. Report
    # status 2 with MISERC_ERR for the caller to surface.
    if [ -e "$p" ] && [ ! -r "$p" ]; then
      MISERC_ERR="cannot read $p"
      return 2
    fi
    lines_load "$p" || { MISERC_ERR="cannot read $p"; return 2; }
    if val=$(lines_read_key "minimum_release_age" "=" "settings"); then
      [ -z "$fallback" ] && fallback="$val"
      if d=$(parse_days_mise "$val"); then
        if [ "$best" -lt 0 ] || [ "$d" -gt "$best" ]; then best="$d"; bestval="$val"; fi
      fi
    fi
  done
  if [ -n "$bestval" ]; then MISE_READ_CONFIGURED="$bestval"; else MISE_READ_CONFIGURED="$fallback"; fi
  if [ "$best" -ge 0 ]; then MISE_READ_DAYS="$best"; else MISE_READ_DAYS=""; fi
}

MISE_READ_PATH=""; MISE_READ_WARN=""; MISE_READ_ROWFAIL=0; MISE_READ_FILES=()
MISE_READ_CONFIGURED=""; MISE_READ_DAYS=""
# Read mise into the MISE_READ_* globals. Echoes "configured|days" for callers
# that still use command substitution; cmd_check calls this directly so the
# metadata survives (command substitution runs in a subshell).
tool_read_mise() {
  local legacy base pmsec action r
  legacy=$(path_mise); base=$(path_mise_base); pmsec=$(path_mise_pmsec)
  action="${MODE:-enable}"
  MISE_READ_WARN=""; MISE_READ_ROWFAIL=0
  if mise_supports_new_mode; then
    if [ "$action" = "enable" ]; then
      # Later environments override earlier keys, so a stricter cooldown in
      # any layer that stays active after enable must be preserved too: both
      # the MISE_ENV layers of this shell and the inherited miserc layers that
      # write keeps ahead of pmsec in the persistent selector.
      local e vals=()
      if [ -n "${MISE_ENV:-}" ]; then
        while IFS= read -r e; do
          [ -n "$e" ] || continue
          [ "$e" = "pmsec" ] && continue
          case "$e" in *[!A-Za-z0-9_.-]*)
            # Status 2: a name that cannot map to a config.<env>.toml path
            # must fail the enable rather than be skipped — silently dropping
            # an active layer lets a stricter cooldown be lowered without
            # --force.
            printf 'unsafe mise environment name: %s\n' "$e" >&2
            return 2 ;;
          esac
          vals[${#vals[@]}]="$(path_mise_dir)/config.$e.toml"
        done < <(mise_env_list "$MISE_ENV")
      fi
      mise_inherited_env || return 2
      for e in "${MISE_BASE_ENV_VALUES[@]}"; do
        [ "$e" = "pmsec" ] && continue
        case "$e" in *[!A-Za-z0-9_.-]*)
          printf 'unsafe mise environment name: %s\n' "$e" >&2
          return 2 ;;
        esac
        vals[${#vals[@]}]="$(path_mise_dir)/config.$e.toml"
      done
      # Status 2 from an unreadable layer must fail the read: judging from a
      # partial merge could lower a stricter cooldown. Return 2 (the "cannot
      # judge" code cmd_enable fails the row on) — status 1 would read as
      # "not configured" and let the enable proceed.
      mise_read_merged "$legacy" "$base" "$pmsec" "${vals[@]}" || {
        printf 'pmsec: %s\n' "$MISERC_ERR" >&2
        return 2
      }
    else
      mise_read_merged "$pmsec" || {
        printf 'pmsec: %s\n' "$MISERC_ERR" >&2
        return 2
      }
    fi
    MISE_READ_PATH="$pmsec"
    mise_selector_state; r=$?
    if [ "$r" = "2" ]; then
      printf 'pmsec: %s\n' "$MISERC_ERR" >&2
      return 1
    fi
    MISE_READ_WARN=$(mise_env_warning)
    [ "$MISE_SELECTOR_WIRED" = "1" ] || MISE_READ_ROWFAIL=1
  else
    mise_has_new_artifacts; r=$?
    [ "$r" = "2" ] && return 1
    if [ "$r" = "0" ] && [ "$action" = "enable" ]; then
      mise_read_merged "$legacy" "$base" "$pmsec" || {
        printf 'pmsec: %s\n' "$MISERC_ERR" >&2
        return 2
      }
    else
      mise_read_merged "$legacy" || {
        printf 'pmsec: %s\n' "$MISERC_ERR" >&2
        return 2
      }
    fi
    MISE_READ_PATH="$legacy"
    if [ "$r" = "0" ]; then
      MISE_READ_WARN="$MISE_MIGRATION_WARN"; MISE_READ_ROWFAIL=1
    fi
  fi
  printf '%s|%s' "$MISE_READ_CONFIGURED" "$MISE_READ_DAYS"
}

_mise_buf_only_structure() {
  local l t
  for l in "${LINES_BUF[@]}"; do
    t="${l//[[:space:]]/}"
    [ -z "$t" ] && continue
    [ "${t:0:1}" = "#" ] && continue
    lines_is_section "$l" && continue
    return 1
  done
  return 0
}

# Remove pmsec-managed keys from a config file. Never deletes it.
# Returns 0 when keys were removed, 1 when there was nothing to remove, and
# 2 when a write failed — callers must not treat a failed cleanup as "skip".
mise_remove_managed_from() {
  local path="$1" ek ev el es esec esafe removed=0
  [ -e "$path" ] || return 1
  # A failed lines_load leaves an empty buffer and would silently skip the
  # removal; an unreadable config must fail the cleanup instead.
  if [ ! -r "$path" ]; then printf 'cannot read %s\n' "$path" >&2; return 2; fi
  lines_load "$path"
  lines_remove_key "minimum_release_age" "=" "settings" && removed=1
  while IFS='|' read -r ek ev el es esec esafe; do
    [ -z "$ek" ] && continue
    lines_remove_key "$ek" "$es" "$esec" && removed=1
  done < <(tool_extras mise)
  [ "$removed" = "1" ] || return 1
  if ! lines_dump | write_atomic "$path"; then return 2; fi
  return 0
}

# Remove pmsec-managed keys from config.pmsec.toml; delete it when nothing but
# whitespace / empty section headers remain. Same 0/1/2 contract.
mise_remove_managed_config() {
  local path="$1" dir ek ev el es esec esafe removed=0
  [ -e "$path" ] || return 1
  # Same unreadable-input refusal as mise_remove_managed_from: a failed
  # lines_load must not silently skip the cleanup.
  if [ ! -r "$path" ]; then printf 'cannot read %s\n' "$path" >&2; return 2; fi
  lines_load "$path"
  lines_remove_key "minimum_release_age" "=" "settings" && removed=1
  while IFS='|' read -r ek ev el es esec esafe; do
    [ -z "$ek" ] && continue
    lines_remove_key "$ek" "$es" "$esec" && removed=1
  done < <(tool_extras mise)
  [ "$removed" = "1" ] || return 1
  # The delete must not follow a user-planted symlinked directory the way the
  # write path refuses to (F2/F13): under root a linked mise dir could
  # redirect the removal at another user's config.
  dir=$(dirname -- "$path")
  _pmsec_root_dir_guard "$dir" || return 2
  if _mise_buf_only_structure; then
    rm -f -- "$path" || return 2
  elif ! lines_dump | write_atomic "$path"; then
    return 2
  fi
  return 0
}

# Remove the pmsec selector from miserc.local.toml. Other env names/keys survive.
# 0 = removed, 1 = nothing to remove, 2 = invalid env or failed write.
mise_remove_selector() {
  local localp="$1" dir r p v changed=0
  local -a kept=()
  if [ -e "$localp" ]; then
    # A failed lines_load would silently skip the removal; an unreadable
    # selector must fail the cleanup instead.
    if [ ! -r "$localp" ]; then printf 'cannot read %s\n' "$localp" >&2; return 2; fi
    lines_load "$localp"
    miserc_parse_env; r=$?
    # The diagnostic must reach cmd_disable's explain_fs_error, which only
    # sees captured stderr: a bare status 2 would produce an empty message.
    [ "$r" = "2" ] && { printf '%s\n' "$MISERC_ERR" >&2; return 2; }
    if [ "$r" = "0" ] && miserc_remove_env_value "pmsec"; then
      changed=1
      # Same symlinked-directory refusal as mise_remove_managed_config (F13).
      dir=$(dirname -- "$localp")
      _pmsec_root_dir_guard "$dir" || return 2
      if _miserc_buf_empty; then
        rm -f -- "$localp" || return 2
      elif ! lines_dump | write_atomic "$localp"; then
        return 2
      fi
    fi
  fi
  # Re-resolve the effective selector AFTER the local change: removing a
  # local assignment can expose a shared/system env list that still selects
  # pmsec, and the next legacy check would re-enable. Materialize the cleaned
  # list into the local file (kept empty writes env = []) so legacy checks
  # converge; the foreign file (often root-owned) stays untouched, mirroring
  # how forward migration materializes inherited names.
  mise_inherited_env || return 2
  if [ -n "$MISE_BASE_ENV_PATH" ] && [ "$MISE_BASE_ENV_PATH" != "$localp" ]; then
    kept=()
    for v in "${MISE_BASE_ENV_VALUES[@]}"; do [ "$v" = "pmsec" ] || kept[${#kept[@]}]="$v"; done
    if [ "${#kept[@]}" -ne "${#MISE_BASE_ENV_VALUES[@]}" ]; then
      # The env indices below must describe THIS buffer: parse the freshly
      # loaded local file, or a shared/system parse would point the splice at
      # unrelated local lines. A local file that was just unlinked loads as an
      # empty buffer and the assignment is inserted at the top.
      lines_load "$localp"
      miserc_parse_env; r=$?
      [ "$r" = "2" ] && { printf '%s\n' "$MISERC_ERR" >&2; return 2; }
      miserc_set_env_values "${kept[@]}"
      dir=$(dirname -- "$localp")
      _pmsec_root_dir_guard "$dir" || return 2
      lines_dump | write_atomic "$localp" || return 2
      return 0
    fi
  fi
  if [ "$changed" = "1" ]; then return 0; fi
  return 1
}

tool_write_mise() {
  local days="$1" legacy base pmsec localp r v
  local -a vals=()
  legacy=$(path_mise); base=$(path_mise_base); pmsec=$(path_mise_pmsec); localp=$(path_mise_local_miserc)
  if mise_supports_new_mode; then
    # Resolve the selector before writing anything: an invalid env array must
    # not leave a half-migrated pair of generations.
    mise_inherited_env || return 1
    for v in "${MISE_BASE_ENV_VALUES[@]}"; do [ "$v" = "pmsec" ] || vals[${#vals[@]}]="$v"; done
    vals[${#vals[@]}]="pmsec"
    lines_load "$localp"
    miserc_parse_env; r=$?
    [ "$r" = "2" ] && { printf '%s\n' "$MISERC_ERR" >&2; return 1; }

    _tool_write_one "$pmsec" "minimum_release_age" "minimum_release_age = \"${days}d\"" "=" "settings" "mise" 0 || return 1

    lines_load "$localp"
    miserc_parse_env; r=$?
    [ "$r" = "2" ] && { printf '%s\n' "$MISERC_ERR" >&2; return 1; }
    miserc_set_env_values "${vals[@]}"
    lines_dump | write_atomic "$localp" || return 1

    # A distinct baseConfig is left untouched; only the legacy write target
    # loses pmsec-managed keys. A failed cleanup must fail the enable.
    mise_remove_managed_from "$legacy"; r=$?
    [ "$r" = "2" ] && return 1
    return 0
  fi

  # Judged before the write so an unreadable miserc fails without touching
  # the config, and again after: replacing a hard-linked legacy file leaves
  # the pmsec link as a distinct file that still holds managed keys.
  local artifacts=0 r2
  mise_has_new_artifacts; r=$?
  [ "$r" = "2" ] && return 1
  [ "$r" = "0" ] && artifacts=1
  _tool_write_one "$legacy" "minimum_release_age" "minimum_release_age = \"${days}d\"" "=" "settings" "mise" 0 || return 1
  # Capture the post-write status: inside an `if` condition a status 2 would
  # be falsy, skipping the cleanup while the enable reports success.
  r2=1
  if [ "$artifacts" = "1" ]; then r2=0; else mise_has_new_artifacts; r2=$?; fi
  [ "$r2" = "2" ] && return 1
  if [ "$r2" = "0" ]; then
    # Reverse migration writes the destination before cleaning the new
    # generation so an interrupted cleanup cannot create a no-config gap.
    # MISE_GLOBAL_CONFIG_FILE can point at config.pmsec.toml itself; the
    # destination then IS the new generation and cleanup would delete it.
    mise_alias_state "$legacy" "$pmsec"
    if [ "$MISE_ALIAS_STATE" = "unknown" ] && mise_has_managed_keys "$pmsec"; then
      printf 'cannot verify %s is distinct from %s; left untouched\n' "$pmsec" "$legacy" >&2
      return 1
    fi
    if [ "$MISE_ALIAS_STATE" = "distinct" ]; then
      mise_remove_managed_config "$pmsec"; r=$?
      [ "$r" = "2" ] && return 1
    fi
    # A nonempty MISE_ENV hides the persistent selector from this shell; a
    # shell that cannot see it must not delete it. The selector artifact
    # reappears on the next clean-shell check and converges there.
    if ! mise_env_override; then
      mise_remove_selector "$localp"; r=$?
      [ "$r" = "2" ] && return 1
    fi
  fi
  # The last statement above is a status test, so without this the enable
  # would report the status of a passed `[ ... ]` (1) as its own.
  return 0
}

tool_unset_mise() {
  # Print 1 when something was removed, 0 when there was nothing to remove,
  # and exit 2 when a cleanup write failed: --disable must not report a
  # successful removal while settings or the selector are still in place.
  local legacy pmsec localp removed=0 r
  legacy=$(path_mise); pmsec=$(path_mise_pmsec); localp=$(path_mise_local_miserc)
  mise_remove_managed_from "$legacy"; r=$?
  [ "$r" = "2" ] && return 2
  [ "$r" = "0" ] && removed=1
  # An aliased destination (MISE_GLOBAL_CONFIG_FILE at config.pmsec.toml) is
  # handled by the remove_managed_from pass above; a second pass could delete
  # the global config itself. An unknown identity with managed keys must fail
  # rather than report a skipped cleanup as success.
  mise_alias_state "$legacy" "$pmsec"
  if [ "$MISE_ALIAS_STATE" = "unknown" ] && mise_has_managed_keys "$pmsec"; then
    printf 'cannot verify %s is distinct from %s; left untouched\n' "$pmsec" "$legacy" >&2
    return 2
  fi
  r=1
  if [ "$MISE_ALIAS_STATE" = "distinct" ]; then mise_remove_managed_config "$pmsec"; r=$?; fi
  [ "$r" = "2" ] && return 2
  [ "$r" = "0" ] && removed=1
  mise_remove_selector "$localp"; r=$?
  [ "$r" = "2" ] && return 2
  [ "$r" = "0" ] && removed=1
  printf '%d' "$removed"
}

# Absolute path with the directory's symlinks resolved, so different
# spellings of the same file (relative, via a symlinked dir) compare equal.
mise_canonical_path() {
  local file="$1" dir base
  dir=$(dirname -- "$file"); base=$(basename -- "$file")
  if [ -d "$dir" ]; then
    dir=$(cd -P -- "$dir" && pwd -P) || dir=$(dirname -- "$file")
  elif [ "${dir#/}" = "$dir" ]; then
    dir="$PWD/$dir"
  fi
  printf '%s/%s' "${dir%/}" "$base"
}

# True only when the path provably does not exist: the nearest existing
# ancestor is searchable, so a failed -e is ENOENT, not EACCES. A symlink
# ancestor whose target cannot be resolved is unknown, not absent.
mise_path_absent() {
  { [ -e "$1" ] || [ -L "$1" ]; } && return 1
  local d; d=$(dirname -- "$1")
  while { [ ! -e "$d" ] && [ ! -L "$d" ]; }; do d=$(dirname -- "$d"); done
  # A file (or symlink) ancestor means the ENOENT came from something other
  # than a genuinely missing leaf: only a searchable real directory proves it.
  [ -d "$d" ] && [ -x "$d" ]
}

# Classify two paths as "aliased", "distinct", or "unknown" in
# MISE_ALIAS_STATE. File identity (-ef) catches spellings a path comparison
# cannot: case variants on case-insensitive filesystems and hard links. An
# identity that cannot be determined is "unknown": callers must not hide
# artifacts or report a skipped destructive cleanup as success.
MISE_ALIAS_STATE="distinct"
mise_alias_state() {
  if [ "$(mise_canonical_path "$1")" = "$(mise_canonical_path "$2")" ]; then
    MISE_ALIAS_STATE="aliased"; return 0
  fi
  if mise_path_absent "$1" || mise_path_absent "$2"; then
    MISE_ALIAS_STATE="distinct"; return 0
  fi
  if { [ -e "$1" ] && [ -e "$2" ]; }; then
    if [ "$1" -ef "$2" ]; then MISE_ALIAS_STATE="aliased"; else MISE_ALIAS_STATE="distinct"; fi
    return 0
  fi
  MISE_ALIAS_STATE="unknown"
  return 0
}

# True when the file holds a pmsec-managed key (in-memory check, no write).
mise_has_managed_keys() {
  local path="$1" ek ev el es esec esafe
  [ -f "$path" ] || return 1
  # An unreadable file counts as managed: cleanup would have to touch it.
  [ -r "$path" ] || return 0
  lines_load "$path"
  lines_remove_key "minimum_release_age" "=" "settings" && return 0
  while IFS='|' read -r ek ev el es esec esafe; do
    [ -z "$ek" ] && continue
    lines_remove_key "$ek" "$es" "$esec" && return 0
  done < <(tool_extras mise)
  return 1
}

mise_doctor_paths() {
  if mise_supports_new_mode; then
    MISE_DOCTOR_PATH=$(path_mise_pmsec)
    MISE_DOCTOR_EXTRA=("$(path_mise)" "$(path_mise_local_miserc)")
    # The selector is always written; the legacy config only when cleanup
    # has managed keys to strip from it.
    if mise_has_managed_keys "$(path_mise)"; then
      MISE_DOCTOR_BLOCKING=("$(path_mise)" "$(path_mise_local_miserc)")
    else
      MISE_DOCTOR_BLOCKING=("$(path_mise_local_miserc)")
    fi
  else
    MISE_DOCTOR_PATH=$(path_mise)
    MISE_DOCTOR_EXTRA=()
    MISE_DOCTOR_BLOCKING=()
  fi
}


# cargo [registry].global-min-publish-age (cargo >= 1.100) uses a quoted
# human duration such as "7 days" rather than the old "7d" syntax.
parse_days_cargo_publish_age() {
  local v="$1" n lc
  [[ "$v" =~ ^\"[[:space:]]*([0-9]+)[[:space:]]*([A-Za-z]+)[[:space:]]*\"$ ]] || return 1
  n="${BASH_REMATCH[1]}"
  lc=$(printf '%s' "${BASH_REMATCH[2]}" | tr '[:upper:]' '[:lower:]')
  case "$lc" in
    day|days) printf '%d' "$n" ;;
    week|weeks) printf '%d' "$((n*7))" ;;
    month|months) printf '%d' "$((n*30))" ;;
    *) return 1 ;;
  esac
}

# uv requires the value to be a quoted string ending in days/weeks (the toml
# parser does not accept duration suffixes outside quotes).
parse_days_uv() {
  local v="$1" n unit lc
  if [[ "$v" =~ ^\"[[:space:]]*([0-9]+)[[:space:]]*(day|days|d|week|weeks|w)[[:space:]]*\"$ ]]; then
    n="${BASH_REMATCH[1]}"; unit="${BASH_REMATCH[2]}"
    lc=$(printf '%s' "$unit" | tr '[:upper:]' '[:lower:]')
    case "$lc" in
      week|weeks|w) printf '%d' "$((n*7))" ;;
      *) printf '%d' "$n" ;;
    esac
    return 0
  fi
  return 1
}

# An undetected version checks config.yaml: pnpm 11+ ignores the rc file, so
# passing on it alone could be a false OK.
pnpm_uses_yaml() {
  local v
  v=$(version_detect pnpm) || return 0
  set -- $v
  [ "$1" -ge 11 ]
}

# Composer's config is JSON; unlike the line-oriented formats above it needs
# the JSON helpers. Keep the primary key tolerant of the shorter npm spelling.
# Composer's cooldown lives under the unified policy block (Composer >= 2.11):
#   {"config": {"policy": {"cooldown": {"period": "7 days"}}}}
# `config.minimum-release-age` was never a Composer key; earlier pmsec
# releases wrote it and Composer silently ignored it. It is removed on write.
COMPOSER_LEGACY_KEYS=(minimum-release-age min-release-age minimum_release_age minimumReleaseAge)

# Composer: "<n> second|minute|hour|day|week[s]" or an integer number of
# seconds (a bare numeric string counts as seconds too). Partial days floor.
parse_days_composer() {
  local v="$1" n lc secs
  v="${v#\"}"; v="${v%\"}"
  v="${v#"${v%%[![:space:]]*}"}"
  v="${v%"${v##*[![:space:]]}"}"
  if [[ "$v" =~ ^([0-9]+)[[:space:]]*([A-Za-z]+)$ ]]; then
    n="${BASH_REMATCH[1]}"
    lc=$(printf '%s' "${BASH_REMATCH[2]}" | tr '[:upper:]' '[:lower:]')
    case "$lc" in
      second|seconds) secs=1 ;;
      minute|minutes) secs=60 ;;
      hour|hours) secs=3600 ;;
      day|days) secs=86400 ;;
      week|weeks) secs=604800 ;;
      *) return 1 ;;
    esac
    printf '%d' "$((n * secs / 86400))"
    return 0
  fi
  [[ "$v" =~ ^[0-9]+$ ]] || return 1
  printf '%d' "$((v / 86400))"
}

tool_read_composer() {
  local path val days
  path=$(tool_path composer)
  lines_load "$path"
  val=$(_json_read_key period config policy cooldown) || return 1
  days=$(parse_days_composer "$val") || days=""
  printf '%s|%s' "$val" "$days"
}

_composer_drop_legacy() {
  local k removed=0
  for k in "${COMPOSER_LEGACY_KEYS[@]}"; do
    if _json_remove_key "$k" config; then removed=1; fi
  done
  return $((1 - removed))
}

tool_write_composer() {
  local days="$1" path
  path=$(tool_path composer)
  lines_load "$path"
  _composer_drop_legacy || true
  _json_set_key "\"$days days\"" period config policy cooldown || return 1
  _json_set_key false allow-plugins config || return 1
  _json_set_key true secure-http config || return 1
  _json_set_key false disable-tls config || return 1
  _json_set_key '"fail"' abandoned config audit || return 1
  lines_dump | write_atomic "$path"
}

tool_unset_composer() {
  local path removed=0
  path=$(tool_path composer)
  lines_load "$path"
  if _json_remove_key period config policy cooldown; then removed=1; fi
  if _composer_drop_legacy; then removed=1; fi
  if _json_remove_key allow-plugins config; then removed=1; fi
  if _json_remove_key secure-http config; then removed=1; fi
  if _json_remove_key disable-tls config; then removed=1; fi
  if _json_remove_key abandoned config audit; then removed=1; fi
  if [ "$removed" = "1" ]; then
    lines_dump | write_atomic "$path" || return 1
  fi
  printf '%d' "$removed"
}

tool_read() {
  local tool="$1" key sep section path val days bval
  if [ "$tool" = "composer" ]; then tool_read_composer; return; fi
  if [ "$tool" = "mise" ]; then tool_read_mise; return; fi
  key=$(tool_key "$tool"); sep=$(tool_sep "$tool"); section=$(tool_section "$tool")
  path=$(tool_path "$tool")
  if [ "$tool" = "pnpm" ] && pnpm_uses_yaml; then
    key='minimumReleaseAge'; sep=':'; section=''
    path=$(path_pnpm_config_yaml)
  fi
  lines_load "$path"
  if ! val=$(lines_read_key "$key" "$sep" "$section"); then
    return 1
  fi
  case "$tool" in
    npm)
      if [[ "$val" =~ ^[0-9]+$ ]]; then days="$val"; else days=""; fi
      ;;
    pnpm)
      if [[ "$val" =~ ^[0-9]+$ ]]; then days=$((val / 1440)); else days=""; fi
      ;;
    bun)
      if [[ "$val" =~ ^[0-9]+$ ]]; then days=$((val / 86400)); else days=""; fi
      ;;
    yarn)
      # yarn 4.10.x mis-parsed the `d` suffix (yarnpkg/berry#6991); a bare
      # number is minutes on every 4.10+, so pmsec writes minutes.
      bval="${val#\"}"; bval="${bval%\"}"
      if [[ "$bval" =~ ^[[:space:]]*([0-9]+)[[:space:]]*$ ]]; then days=$((BASH_REMATCH[1] / 1440))
      else days=$(parse_days_dw "$val") || days=""; fi
      ;;
    cargo) days=$(parse_days_cargo_publish_age "$val") || days=$(parse_days_dw "$val") || days="" ;;
    mise) days=$(parse_days_mise "$val") || days="" ;;
    uv) days=$(parse_days_uv "$val") || days="" ;;
    bundler)
      # bundler stores a plain integer number of days, quoted (BUNDLE_COOLDOWN: "7").
      bval="${val#\"}"; bval="${bval%\"}"
      if [[ "$bval" =~ ^[0-9]+$ ]]; then days="$bval"; else days=""; fi
      ;;
    aube)
      if [[ "$val" =~ ^[0-9]+$ ]]; then days=$((val / 1440)); else days=""; fi
      ;;
    *) days="" ;;
  esac
  printf '%s|%s' "$val" "$days"
}

# ---------- per-tool: write ----------

tool_write_value_line() {
  local tool="$1" days="$2" key
  key=$(tool_key "$tool")
  case "$tool" in
    npm)   printf '%s=%d' "$key" "$days" ;;
    pnpm)  printf '%s=%d' "$key" "$((days * 1440))" ;;
    yarn)  printf '%s: %d' "$key" "$((days * 1440))" ;;
    bun)   printf '%s = %d' "$key" "$((days * 86400))" ;;
    cargo) printf '%s = "%d days"' "$key" "$days" ;;
    mise)  printf '%s = "%dd"' "$key" "$days" ;;
    uv)    printf '%s = "%d days"' "$key" "$days" ;;
    bundler) printf '%s: "%d"' "$key" "$days" ;;
    aube)  printf '%s = %d' "$key" "$((days * 1440))" ;;
    composer) printf '%s' "$days" ;;
  esac
}

_tool_write_one() {
  local path="$1" key="$2" line="$3" sep="$4" section="$5" tool="$6" yaml="${7:-0}"
  local ek ev el es esec esafe extras_fn=tool_extras
  [ "$yaml" = "1" ] && extras_fn=tool_extras_yaml
  lines_load "$path"
  lines_set_key "$key" "$line" "$sep" "$section"
  local cur
  while IFS='|' read -r ek ev el es esec esafe; do
    [ -z "$ek" ] && continue
    # Keep an existing safe value (e.g. a stricter one) unless --force.
    if [ "${OPT_FORCE:-0}" != "1" ] && cur=$(lines_read_key "$ek" "$es" "$esec"); then
      case ",${esafe:-$ev}," in *",$cur,"*) continue ;; esac
    fi
    lines_set_key "$ek" "$el" "$es" "$esec"
  done < <("$extras_fn" "$tool")
  if [ "$tool" = "cargo" ] && [ "$yaml" = "0" ]; then
    # Drop the pre-2026.10 key: cargo never implemented it.
    lines_remove_key 'minimum-release-age' '=' 'install' || true
  fi
  lines_dump | write_atomic "$path"
}

tool_write() {
  local tool="$1" days="$2" path key sep section line
  if [ "$tool" = "composer" ]; then tool_write_composer "$days"; return; fi
  if [ "$tool" = "mise" ]; then tool_write_mise "$days"; return; fi
  path=$(tool_path "$tool"); key=$(tool_key "$tool")
  sep=$(tool_sep "$tool"); section=$(tool_section "$tool")
  line=$(tool_write_value_line "$tool" "$days")
  _tool_write_one "$path" "$key" "$line" "$sep" "$section" "$tool" 0 || return 1
  if [ "$tool" = "pnpm" ]; then
    _tool_write_one "$(path_pnpm_config_yaml)" 'minimumReleaseAge' \
      "minimumReleaseAge: $((days * 1440))" ':' '' "$tool" 1 || return 1
  fi
}

_tool_unset_one() {
  local path="$1" tool="$2" yaml="${3:-0}" key sep section removed=0
  if [ "$yaml" = "1" ]; then
    key='minimumReleaseAge'; sep=':'; section=''
  else
    key=$(tool_key "$tool"); sep=$(tool_sep "$tool"); section=$(tool_section "$tool")
  fi
  lines_load "$path"
  if lines_remove_key "$key" "$sep" "$section"; then removed=1; fi
  local ek ev el es esec esafe extras_fn=tool_extras
  [ "$yaml" = "1" ] && extras_fn=tool_extras_yaml
  while IFS='|' read -r ek ev el es esec esafe; do
    [ -z "$ek" ] && continue
    if lines_remove_key "$ek" "$es" "$esec"; then removed=1; fi
  done < <("$extras_fn" "$tool")
  if [ "$tool" = "cargo" ] && [ "$yaml" = "0" ]; then
    if lines_remove_key 'minimum-release-age' '=' 'install'; then removed=1; fi
  fi
  if [ "$removed" = "1" ]; then
    lines_dump | write_atomic "$path" || return 1
  fi
  printf '%d' "$removed"
}

tool_unset() {
  local tool="$1" path removed=0 r
  if [ "$tool" = "composer" ]; then tool_unset_composer; return; fi
  if [ "$tool" = "mise" ]; then tool_unset_mise; return; fi
  path=$(tool_path "$tool")
  r=$(_tool_unset_one "$path" "$tool" 0) || return 1
  [ "$r" = "1" ] && removed=1
  if [ "$tool" = "pnpm" ]; then
    r=$(_tool_unset_one "$(path_pnpm_config_yaml)" "$tool" 1) || return 1
    [ "$r" = "1" ] && removed=1
  fi
  printf '%d' "$removed"
}

# Emit per-extra state for $1 as: key|configured|expected|ok|defaultEnforced
# where ok is 1 if the value is in force (configured matches expected, OR the
# runtime enforces it as a default and the line is absent), 0 otherwise;
# configured is empty when missing; defaultEnforced is 1 only when ok was
# granted via runtime default rather than an explicit line.
#
# pnpm 11 made `block-exotic-subdeps=true` the default, so a missing line is
# still secure under pnpm >= 11 — surface that instead of a false MISSING.
_composer_extra() {
  local key="$1" expected="$2" cur ok=0
  shift 2
  if cur=$(_json_read_key "$key" "$@"); then
    [ "$cur" = "$expected" ] && ok=1
  else
    cur=""
  fi
  printf '%s|%s|%s|%s|0\n' "$key" "$cur" "$expected" "$ok"
}

tool_read_extras_mise() {
  local ek ev el es esec esafe p cur chosen ok
  while IFS='|' read -r ek ev el es esec esafe; do
    [ -z "$ek" ] && continue
    chosen=""; ok=0
    for p in "${MISE_READ_FILES[@]}"; do
      lines_load "$p"
      if cur=$(lines_read_key "$ek" "$es" "$esec"); then
        if [ -z "$chosen" ]; then chosen="$cur"; fi
        if [ -n "$esafe" ]; then
          case ",$esafe," in *",$cur,"*) ok=1; chosen="$cur" ;; esac
        elif [ "$cur" = "$ev" ]; then
          ok=1; chosen="$cur"
        fi
        [ "$ok" = "1" ] && break
      fi
    done
    printf '%s|%s|%s|%s|0\n' "$ek" "$chosen" "$ev" "$ok"
  done < <(tool_extras mise)
}

tool_read_extras() {
  local tool="$1" path ek ev el es esec esafe cur ok def
  local pnpm_major="" extras_fn=tool_extras
  if [ "$tool" = "composer" ]; then
    path=$(tool_path "$tool")
    lines_load "$path"
    _composer_extra allow-plugins false config
    _composer_extra secure-http true config
    _composer_extra disable-tls false config
    _composer_extra abandoned '"fail"' config audit
    return 0
  fi
  if [ "$tool" = "mise" ]; then
    tool_read_extras_mise
    return 0
  fi
  if [ "$tool" = "pnpm" ]; then
    if v=$(version_detect pnpm); then
      set -- $v
      pnpm_major="$1"
    fi
    if [ -z "$pnpm_major" ] || [ "$pnpm_major" -ge 11 ]; then
      extras_fn=tool_extras_yaml; path=$(path_pnpm_config_yaml)
    else
      path=$(tool_path "$tool")
    fi
  else
    path=$(tool_path "$tool")
  fi
  lines_load "$path"
  while IFS='|' read -r ek ev el es esec esafe; do
    [ -z "$ek" ] && continue
    def=0
    if cur=$(lines_read_key "$ek" "$es" "$esec"); then
      if [ -n "$esafe" ]; then
        case ",$esafe," in
          *",$cur,"*) ok=1 ;;
          *) ok=0 ;;
        esac
      elif [ "$cur" = "$ev" ]; then
        ok=1
      else
        ok=0
      fi
    else
      cur=""; ok=0
      if [ "$tool" = "pnpm" ] && [ "$ek" = "blockExoticSubdeps" ] \
         && [ -n "$pnpm_major" ] && [ "$pnpm_major" -ge 11 ]; then
        ok=1; def=1
      elif [ "$tool" = "pnpm" ] && [ "$ek" = "block-exotic-subdeps" ] \
         && [ -n "$pnpm_major" ] && [ "$pnpm_major" -ge 11 ]; then
        ok=1; def=1
      fi
    fi
    printf '%s|%s|%s|%s|%s\n' "$ek" "$cur" "$ev" "$ok" "$def"
  done < <("$extras_fn" "$tool")
}

# ---------- per-tool: preflight (silently-ignored cooldown warning) ----------

tool_preflight() {
  local tool="$1" v min msg
  case "$tool" in
    npm)  min='11 10 0';   msg='min-release-age is silently ignored. Upgrade npm to enforce the cooldown.' ;;
    pnpm) min='10 6 0';    msg='minimum-release-age is silently ignored. Upgrade pnpm to enforce the cooldown.' ;;
    yarn) min='4 10 0';    msg='npmMinimalAgeGate is silently ignored. Upgrade yarn (v4.10+) to enforce the cooldown.' ;;
    bun)  min='1 3 0';     msg='minimumReleaseAge is silently ignored. Upgrade bun to enforce the cooldown.' ;;
    mise) min='2026 4 22'; msg='setting was named install_before before 2026.4.22 and minimum_release_age is silently ignored on older mise. Upgrade mise (`mise self-update`) to enforce the cooldown.' ;;
    # 0.9.17 added relative exclude-newer; the [audit] table only parses from 0.11.3.
    uv)   min='0 11 3';    msg='the written uv.toml (relative exclude-newer and the [audit] table) will not parse on this uv and every uv command will fail until you `uv self update`.' ;;
    composer) min='2 11 0'; msg='config.policy.cooldown is silently ignored. Upgrade Composer to enforce the cooldown.' ;;
    bundler) min='4 0 13'; msg='BUNDLE_COOLDOWN is silently ignored. Upgrade bundler (v4.0.13+) to enforce the cooldown.' ;;
    cargo) min='1 100 0';  msg='global-min-publish-age is silently ignored. Upgrade cargo to enforce the cooldown.' ;;
  esac
  v=$(version_detect "$tool") || return 0
  set -- $v
  version_gte "$1" "$2" "$3" $min || \
    printf '%s %s < %s: %s' "$tool" "$4" "${min// /.}" "$msg"
}

# ---------- JSON helpers ----------

json_escape() {
  local s="$1" out="" i c ord
  for ((i=0; i<${#s}; i++)); do
    c="${s:i:1}"
    case "$c" in
      \\) out+='\\' ;;
      \") out+='\"' ;;
      $'\b') out+='\b' ;;
      $'\n') out+='\n' ;;
      $'\r') out+='\r' ;;
      $'\t') out+='\t' ;;
      $'\f') out+='\f' ;;
      *)
        # Every remaining C0 control must be escaped for strict JSON.
        ord=$(printf '%d' "'$c")
        if [ "$ord" -lt 32 ]; then out+=$(printf '\\u%04x' "$ord"); else out+="$c"; fi
        ;;
    esac
  done
  printf '"%s"' "$out"
}

# json_value emits either `"…"` (escaped) or `null` if $2 == "1"
json_str() { json_escape "$1"; }
json_str_or_null() {
  if [ "${2:-0}" = "1" ]; then printf 'null'; else json_escape "$1"; fi
}
json_int_or_null() {
  if [ -z "$1" ]; then printf 'null'; else printf '%d' "$1"; fi
}
json_bool() { if [ "$1" = "1" ]; then printf 'true'; else printf 'false'; fi; }

# ---------- CLI ----------

USAGE() {
  cat <<EOF
pmsec [options]

Zero-config install-time supply-chain hardening across npm, pnpm, yarn,
bun, cargo, mise, uv, bundler, aube, composer. Default action enables every safe-by-default
key each tool exposes (cooldown, audit-level, trust-policy, hardened mode,
attestation re-verification, ...). No knobs.

Options:
  --check               Verify the bundle is in place (exit 1 if anything missing)
  --disable             Remove the hardening bundle from selected tools
  --doctor              Diagnose effective paths/owner/uid (read-only; for unattended-deployment debugging)
  --tool TOOL[,TOOL]    Restrict to specific tools (npm,pnpm,yarn,bun,cargo,mise,uv,bundler,aube,composer)
  --days N              Override cooldown days (default 1)
  --force               Overwrite stricter existing cooldowns and hardening values (otherwise enable is monotonic)
  --json                Emit JSON output
  -V, --version         Show version
  -h, --help            Show this help

Examples:
  pmsec
  pmsec --days 7
  pmsec --days 1 --force
  pmsec --check
  pmsec --disable --tool npm

Environment:
  PMSEC_HOME            Home dir to operate on (overrides \$HOME). Set this
                        when running as root via an orchestrator (Jamf,
                        Intune, Ansible, SCCM, scheduled task, RMM, …) so
                        configs land in the real user's home. Files written
                        as root are chowned back to the home dir's owner.
  PMSEC_PNPM_CONFIG_FILE Override the pnpm rc config file path.
  PMSEC_PNPM_CONFIG_YAML Override the pnpm config.yaml path.
  NPM_CONFIG_USERCONFIG Override the npm/pnpm config file path.
  YARN_RC_FILENAME      Override the yarn config file path.
  BUN_CONFIG_FILE       Override the bun config file path.
  CARGO_HOME            Override the cargo dir; pmsec writes \$CARGO_HOME/config.toml.
  MISE_GLOBAL_CONFIG_FILE Force legacy mise mode: write this single file
                        instead of config.pmsec.toml + the miserc selector.
  MISE_CONFIG_DIR       Override the global mise config dir (also used
                        for config.pmsec.toml and miserc.local.toml).
  MISE_SYSTEM_CONFIG_DIR Read the system miserc.toml from here.
  MISE_ENV              Replaces the miserc env list; when set without
                        \`pmsec\`, --check reports the layer as inactive.
  AUBE_CONFIG_FILE      Override the aube config file path.
  COMPOSER_HOME         Override the Composer home dir; pmsec writes \$COMPOSER_HOME/config.json.
  UV_CONFIG_FILE        Override the uv config file path.
  XDG_CONFIG_HOME       Override the XDG config root (affects mise, aube, uv, composer on linux/mac).
EOF
}

# parse_args populates: MODE (enable|check|disable), OPT_JSON, OPT_ONLY (csv),
# OPT_DAYS, OPT_FORCE, OPT_HELP, OPT_VERSION.
parse_args() {
  MODE="enable"; MODE_SET=0
  OPT_JSON=0; OPT_ONLY=""; OPT_DAYS="$BUNDLE_DAYS"; OPT_FORCE=0; OPT_HELP=0; OPT_VERSION=0
  POS=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help)    OPT_HELP=1 ;;
      -V|--version) OPT_VERSION=1 ;;
      --json)       OPT_JSON=1 ;;
      --force)      OPT_FORCE=1 ;;
      --check)
        if [ "$MODE_SET" = "1" ] && [ "$MODE" != "check" ]; then
          printf 'pmsec: --check, --disable, and --doctor are mutually exclusive\n' >&2; return 2
        fi
        MODE="check"; MODE_SET=1 ;;
      --disable)
        if [ "$MODE_SET" = "1" ] && [ "$MODE" != "disable" ]; then
          printf 'pmsec: --check, --disable, and --doctor are mutually exclusive\n' >&2; return 2
        fi
        MODE="disable"; MODE_SET=1 ;;
      --doctor)
        if [ "$MODE_SET" = "1" ] && [ "$MODE" != "doctor" ]; then
          printf 'pmsec: --check, --disable, and --doctor are mutually exclusive\n' >&2; return 2
        fi
        MODE="doctor"; MODE_SET=1 ;;
      --tool)       shift; OPT_ONLY="$1" ;;
      --tool=*)     OPT_ONLY="${1#--tool=}" ;;
      --days)       shift; OPT_DAYS="$1"; _validate_days "$OPT_DAYS" || return 2 ;;
      --days=*)     OPT_DAYS="${1#--days=}"; _validate_days "$OPT_DAYS" || return 2 ;;
      --)           shift; while [ $# -gt 0 ]; do POS[${#POS[@]}]="$1"; shift; done; break ;;
      -*)           printf 'pmsec: unknown flag: %s\n' "$1" >&2; return 2 ;;
      *)            POS[${#POS[@]}]="$1" ;;
    esac
    shift
  done
  if [ "${#POS[@]}" -gt 0 ]; then
    printf 'pmsec: unexpected argument: %s\n' "${POS[0]}" >&2
    return 2
  fi
  return 0
}

_validate_days() {
  case "$1" in
    ''|*[!0-9]*) ;;
    *) [ "$1" -ge 1 ] && return 0 ;;
  esac
  printf 'pmsec: --days must be a positive integer (got "%s")\n' "$1" >&2
  return 1
}

# Resolve OPT_ONLY (csv or empty) → SELECTED array of tool names.
select_tools() {
  SELECTED=()
  if [ -z "$OPT_ONLY" ]; then
    SELECTED=("${TOOLS[@]}")
    return 0
  fi
  local IFS=','
  set -f
  set -- $OPT_ONLY
  set +f
  unset IFS
  local n missing=()
  for n in "$@"; do
    case " ${TOOLS[*]} " in
      *" $n "*) SELECTED[${#SELECTED[@]}]="$n" ;;
      *) missing[${#missing[@]}]="$n" ;;
    esac
  done
  if [ "${#missing[@]}" -gt 0 ]; then
    printf 'pmsec: unknown tool(s): %s\n' "$(IFS=','; printf '%s' "${missing[*]}")" >&2
    return 2
  fi
}

status_for() {
  local days="$1" min="$2"
  if [ -z "$days" ]; then printf 'MISSING'; return; fi
  if [ "$days" -lt "$min" ]; then printf 'STALE  '; return; fi
  printf 'OK     '
}

pad4() {
  local s="$1"
  case "${#s}" in
    1) printf '%s   ' "$s" ;;
    2) printf '%s  '  "$s" ;;
    3) printf '%s '   "$s" ;;
    *) printf '%s'    "$s" ;;
  esac
}

cmd_check() {
  local rows_json="" first=1 failing=0 failing_extras=0 row_failures=0 unwired=0 tool path val days warn r
  for tool in "${SELECTED[@]}"; do
    path=$(tool_path "$tool")
    val=""; days=""; warn=""; local selector_json="" row_fail=0 mise_warn="" row_unwired=0
    if [ "$tool" = "mise" ]; then
      if ! tool_read_mise >/dev/null; then return 1; fi
      val="$MISE_READ_CONFIGURED"; days="$MISE_READ_DAYS"; path="$MISE_READ_PATH"
      mise_warn="$MISE_READ_WARN"; row_fail="$MISE_READ_ROWFAIL"
      warn=$(tool_preflight "$tool")
      [ -n "$mise_warn" ] && warn="${warn:+$warn }$mise_warn"
      if [ -n "$MISE_SELECTOR_PATH" ]; then
        local sv="" first_v=1 iv
        for ((iv=0; iv<${#MISE_SELECTOR_VALUES[@]}; iv++)); do
          [ "$first_v" = "1" ] || sv+=", "
          first_v=0; sv+=$(json_str "${MISE_SELECTOR_VALUES[iv]}")
        done
        selector_json="\"selector\": {\"path\": $(json_str "$MISE_SELECTOR_PATH"), \"env\": [$sv], \"wired\": $(json_bool "$MISE_SELECTOR_WIRED")}, "
        if [ "$MISE_SELECTOR_WIRED" != "1" ]; then row_fail=1; row_unwired=1; unwired=$((unwired+1)); fi
      fi
      [ "$row_fail" = "1" ] && row_failures=$((row_failures+1))
    else
      if r=$(tool_read "$tool"); then
        val="${r%|*}"; days="${r##*|}"
      fi
      warn=$(tool_preflight "$tool")
    fi
    if [ -z "$days" ] || [ "$days" -lt "$OPT_DAYS" ]; then failing=$((failing+1)); fi

    # Collect extras for this tool into parallel arrays.
    local row_key; row_key=$(tool_key "$tool")
    if [ "$tool" = "pnpm" ] && pnpm_uses_yaml; then
      row_key='minimumReleaseAge'; path=$(path_pnpm_config_yaml)
    fi

    local extras_keys=() extras_cur=() extras_exp=() extras_ok=() extras_def=() ek ec ee eo ed
    while IFS='|' read -r ek ec ee eo ed; do
      [ -z "$ek" ] && continue
      extras_keys+=("$ek"); extras_cur+=("$ec"); extras_exp+=("$ee"); extras_ok+=("$eo"); extras_def+=("${ed:-0}")
      [ "$eo" = "0" ] && failing_extras=$((failing_extras+1))
    done < <(tool_read_extras "$tool")

    if [ "$OPT_JSON" = "1" ]; then
      local cfg_json days_json warn_json missing=0
      [ -z "$val" ] && [ -z "$days" ] && missing=1
      if [ "$missing" = "1" ]; then cfg_json="null"; else cfg_json=$(json_str "$val"); fi
      days_json=$(json_int_or_null "$days")
      if [ -z "$warn" ]; then warn_json="null"; else warn_json=$(json_str "$warn"); fi
      [ "$first" = "1" ] || rows_json+=','$'\n'
      first=0
      rows_json+=$'    {'
      rows_json+="\"tool\": $(json_str "$tool"), "
      rows_json+="\"key\": $(json_str "$row_key"), "
      rows_json+="\"path\": $(json_str "$path"), "
      rows_json+="\"configured\": $cfg_json, "
      rows_json+="\"days\": $days_json, "
      rows_json+="$selector_json"
      rows_json+="\"warn\": $warn_json, "
      rows_json+='"extras": ['
      local ei
      for ((ei=0; ei<${#extras_keys[@]}; ei++)); do
        [ "$ei" -gt 0 ] && rows_json+=", "
        local ec_json ok_json def_json
        if [ -z "${extras_cur[ei]}" ]; then ec_json="null"; else ec_json=$(json_str "${extras_cur[ei]}"); fi
        if [ "${extras_ok[ei]}" = "1" ]; then ok_json="true"; else ok_json="false"; fi
        if [ "${extras_def[ei]}" = "1" ]; then def_json=", \"defaultEnforced\": true"; else def_json=""; fi
        rows_json+="{\"key\": $(json_str "${extras_keys[ei]}"), \"configured\": $ec_json, \"expected\": $(json_str "${extras_exp[ei]}"), \"ok\": $ok_json$def_json}"
      done
      rows_json+=']}'
    else
      local status display
      if [ -z "$val" ]; then display="(unset)"; else display="$val"; fi
      status=$(status_for "$days" "$OPT_DAYS")
      printf '%s %s %s = %s  [%s]\n' "$status" "$(pad4 "$tool")" "$row_key" "$display" "$path"
      if [ -n "$warn" ]; then printf '       \xe2\x9a\xa0 %s\n' "$warn"; fi
      if [ "$row_unwired" = "1" ] && [ -z "$warn" ]; then printf '       \xe2\x9a\xa0 pmsec env not selected  [%s]\n' "$MISE_SELECTOR_PATH"; fi
      local ei ex_status ex_display
      for ((ei=0; ei<${#extras_keys[@]}; ei++)); do
        if [ "${extras_def[ei]}" = "1" ]; then
          ex_status="OK     "; ex_display="(default — runtime enforces ${extras_exp[ei]})"
        elif [ -z "${extras_cur[ei]}" ]; then
          ex_status="MISSING"; ex_display="(unset)"
        elif [ "${extras_ok[ei]}" = "1" ]; then
          ex_status="OK     "; ex_display="${extras_cur[ei]}"
        else
          ex_status="STALE  "; ex_display="${extras_cur[ei]}"
        fi
        printf '%s %s %s = %s  [%s]\n' "$ex_status" "$(pad4 "$tool")" "${extras_keys[ei]}" "$ex_display" "$path"
      done
    fi
  done
  if [ "$OPT_JSON" = "1" ]; then
    local ok="true"
    { [ "$failing" -gt 0 ] || [ "$failing_extras" -gt 0 ] || [ "$row_failures" -gt 0 ]; } && ok="false"
    printf '{\n  "bundleDays": %d,\n  "rows": [\n%s\n  ],\n  "ok": %s\n}\n' "$OPT_DAYS" "$rows_json" "$ok"
  fi
  [ "$failing" -gt 0 ] && printf 'pmsec: %d tool(s) below %d days — run `pmsec`\n' "$failing" "$OPT_DAYS" >&2
  [ "$failing_extras" -gt 0 ] && printf 'pmsec: %d hardening setting(s) not at safe value — run `pmsec`\n' "$failing_extras" >&2
  [ "$unwired" -gt 0 ] && printf 'pmsec: pmsec environment not selected by mise miserc — run `pmsec`\n' >&2
  { [ "$failing" -gt 0 ] || [ "$failing_extras" -gt 0 ] || [ "$row_failures" -gt 0 ]; } && return 1
  return 0
}

explain_fs_error() {
  # Mirror node's explainFsError. We don't have an errno, but the OS error
  # text reliably contains "Permission denied" (POSIX standard EACCES/EPERM
  # message) or "Read-only file system" (EROFS). Match those and prepend a
  # remediation hint pointing the operator at the file ownership / mount
  # state — the two failure modes that bite Jamf/ansible scripts. The raw
  # cause is collapsed into a single-line summary (last line only) so the
  # message fits a JSON `error` field.
  local tool="$1" raw="$2" path="$3"
  local q="" cause
  cause=$(printf '%s' "$raw" | tail -n 1)
  if [ -n "$path" ]; then q="'${path//\'/\'\\\'\'}'"; fi
  case "$raw" in
    *"Permission denied"*|*"Operation not permitted"*)
      if [ -n "$path" ]; then
        printf '%s: cannot write %s (Permission denied). Check file ownership: `ls -la %s` — if owned by root, run `sudo chown -h $(id -u):$(id -g) %s`. [%s]' \
          "$tool" "$path" "$q" "$q" "$cause"
      else
        printf '%s: Permission denied. [%s]' "$tool" "$cause"
      fi
      return 0
      ;;
    *"Read-only file system"*)
      printf '%s: %s is on a read-only filesystem (EROFS). [%s]' "$tool" "$path" "$cause"
      return 0
      ;;
  esac
  printf '%s: %s' "$tool" "$cause"
}

cmd_enable() {
  local results_json="" warns_json="" first_r=1 first_w=1 failures=0 warn_count=0
  local tool path warn err cur_days effective kept r read_rc
  for tool in "${SELECTED[@]}"; do
    path=$(tool_path "$tool")
    warn=$(tool_preflight "$tool")
    err=""
    if [ "$OPT_FORCE" = "1" ]; then
      effective="$OPT_DAYS"; kept=0
    else
      # Status 2 from a read (unreadable file, invalid miserc, unsafe env
      # name) must fail the row: enabling from a value pmsec could not read,
      # or a layer it cannot resolve, would lower a cooldown without --force.
      cur_days=""
      r=$(tool_read "$tool" 2>&1); read_rc=$?
      if [ "$read_rc" = "0" ]; then
        cur_days="${r##*|}"
      elif [ "$read_rc" = "2" ]; then
        err=$(explain_fs_error "$tool" "$r" "$path")
        # The failing read has no writable file to blame; node reports the
        # same shape with a null path.
        path=""
        failures=$((failures+1))
      fi
      [ -z "$cur_days" ] && cur_days=0
      if [ "$cur_days" -ge "$OPT_DAYS" ] && [ "$cur_days" -gt 0 ]; then
        effective="$cur_days"; kept=1
      else
        effective="$OPT_DAYS"; kept=0
      fi
    fi
    if [ -z "$err" ] && ! out=$(tool_write "$tool" "$effective" 2>&1); then
      err=$(explain_fs_error "$tool" "$out" "$path")
      # A malformed miserc has no file to blame: keep the row's path null so
      # every port reports the same shape for this failure.
      case "$out" in *"miserc env"*) path="" ;; esac
      failures=$((failures+1))
    fi
    if [ "$tool" = "mise" ] && [ -z "$err" ]; then
      if mise_supports_new_mode; then
        path=$(path_mise_pmsec)
        # Only the new generation surfaces the MISE_ENV row warning; a legacy
        # enable has no selector to shadow.
        local mise_write_warn; mise_write_warn=$(mise_env_warning)
        [ -n "$mise_write_warn" ] && warn="${warn:+$warn }$mise_write_warn"
      else
        path=$(path_mise)
      fi
    fi
    if [ -n "$warn" ]; then warn_count=$((warn_count+1)); fi
    if [ "$OPT_JSON" = "1" ]; then
      local ok_json warn_json err_json kept_json
      if [ -z "$err" ]; then ok_json="true"; else ok_json="false"; fi
      if [ -z "$warn" ]; then warn_json="null"; else warn_json=$(json_str "$warn"); fi
      if [ "$kept" = "1" ]; then kept_json="true"; else kept_json="false"; fi
      local forced_json="false"; [ "$OPT_FORCE" = "1" ] && forced_json="true"
      [ "$first_r" = "1" ] || results_json+=','$'\n'
      first_r=0
      results_json+=$'    {'
      results_json+="\"tool\": $(json_str "$tool"), "
      if [ -z "$path" ]; then results_json+="\"path\": null, "; else results_json+="\"path\": $(json_str "$path"), "; fi
      results_json+="\"days\": $effective, "
      results_json+="\"requested\": $OPT_DAYS, "
      results_json+="\"kept\": $kept_json, "
      results_json+="\"forced\": $forced_json, "
      results_json+="\"ok\": $ok_json, "
      results_json+="\"warn\": $warn_json"
      if [ -n "$err" ]; then
        err_json=$(json_str "$err")
        results_json+=", \"error\": $err_json"
      fi
      results_json+='}'
      if [ -n "$warn" ]; then
        [ "$first_w" = "1" ] || warns_json+=','$'\n'
        first_w=0
        warns_json+=$'    {'"\"tool\": $(json_str "$tool"), \"warn\": $(json_str "$warn")}"
      fi
    else
      if [ -z "$err" ]; then
        if [ "$kept" = "1" ]; then
          printf 'keep    %s [%s]  (kept existing %dd ≥ %dd)\n' "$(pad4 "$tool")" "$path" "$effective" "$OPT_DAYS"
        else
          printf 'enable  %s [%s]\n' "$(pad4 "$tool")" "$path"
        fi
        if [ -n "$warn" ]; then printf '     \xe2\x9a\xa0 %s\n' "$warn"; fi
      else
        printf 'FAIL    %s %s\n' "$(pad4 "$tool")" "$err"
      fi
    fi
    if [ -n "$err" ]; then printf 'pmsec: %s\n' "$err" >&2; fi
  done
  if [ "$OPT_JSON" = "1" ]; then
    local ok="true"; [ "$failures" -gt 0 ] && ok="false"
    printf '{\n  "enabled": true,\n  "bundleDays": %d,\n  "results": [\n%s\n  ],\n  "warnings": [' "$OPT_DAYS" "$results_json"
    if [ -n "$warns_json" ]; then printf '\n%s\n  ' "$warns_json"; fi
    printf '],\n  "ok": %s\n}\n' "$ok"
  fi
  if [ "$warn_count" -gt 0 ]; then
    printf 'pmsec: %d tool(s) configured but runtime may silently ignore the cooldown — see ⚠ above\n' "$warn_count" >&2
  fi
  [ "$failures" -gt 0 ] && return 1
  return 0
}

cmd_disable() {
  local results_json="" first_r=1 failures=0 tool path err removed
  for tool in "${SELECTED[@]}"; do
    path=$(tool_path "$tool")
    err=""; removed=0
    if out=$(tool_unset "$tool" 2>&1); then
      removed="$out"
    else
      err=$(explain_fs_error "$tool" "$out" "$path"); failures=$((failures+1))
    fi
    if [ "$tool" = "mise" ]; then
      if mise_supports_new_mode; then path=$(path_mise_pmsec); else path=$(path_mise); fi
    fi
    if [ "$OPT_JSON" = "1" ]; then
      local ok_json rm_json
      if [ -z "$err" ]; then ok_json="true"; else ok_json="false"; fi
      if [ "$removed" = "1" ]; then rm_json="true"; else rm_json="false"; fi
      [ "$first_r" = "1" ] || results_json+=','$'\n'
      first_r=0
      results_json+=$'    {'
      results_json+="\"tool\": $(json_str "$tool"), "
      results_json+="\"path\": $(json_str "$path"), "
      results_json+="\"removed\": $rm_json, "
      results_json+="\"ok\": $ok_json"
      if [ -n "$err" ]; then results_json+=", \"error\": $(json_str "$err")"; fi
      results_json+='}'
    else
      if [ -n "$err" ]; then
        printf 'FAIL    %s %s\n' "$(pad4 "$tool")" "$err"
      elif [ "$removed" = "1" ]; then
        printf 'disable %s [%s]\n' "$(pad4 "$tool")" "$path"
      else
        printf 'skip    %s [%s]\n' "$(pad4 "$tool")" "$path"
      fi
    fi
    [ -n "$err" ] && printf 'pmsec: %s\n' "$err" >&2
  done
  if [ "$OPT_JSON" = "1" ]; then
    local ok="true"; [ "$failures" -gt 0 ] && ok="false"
    printf '{\n  "results": [\n%s\n  ],\n  "ok": %s\n}\n' "$results_json" "$ok"
  fi
  [ "$failures" -gt 0 ] && return 1
  return 0
}

# `pmsec --doctor` runs read-only and reports the same path resolution that
# enable/check/disable would do, plus identity (uid/euid) and parent-dir
# writability — the smallest set of facts an operator needs to diagnose
# "pmsec ran but wrote to nowhere" (root's $HOME) or "wrote a file no one
# can read" (chown failed under SIP/SELinux). Never mutates the filesystem.
_pmsec_deepest_existing() {
  # Walk up to the deepest existing ancestor — pmsec runs mkdir -p, so what
  # matters is whether that ancestor is writable, not the literal parent.
  local p="$1"
  while [ -n "$p" ] && [ "$p" != "/" ] && [ ! -d "$p" ]; do
    p=$(dirname -- "$p")
  done
  [ -d "$p" ] && printf '%s' "$p" || printf ''
}

# Echo "exists writable parent_exists parent_writable owner_uid"
# (each token "0"/"1" except owner_uid which is "" when not detected).
_pmsec_probe_path() {
  local p="$1" parent exists=0 writable=0 parent_exists=0 parent_writable=0 owner=""
  parent=$(dirname -- "$p")
  if [ -e "$p" ]; then
    exists=1
    [ -w "$p" ] && writable=1
    owner=$(_pmsec_stat '%u' '%u' "$p")
  fi
  [ -d "$parent" ] && parent_exists=1
  local anc; anc=$(_pmsec_deepest_existing "$parent")
  [ -n "$anc" ] && [ -w "$anc" ] && parent_writable=1
  printf '%d %d %d %d %s' "$exists" "$writable" "$parent_exists" "$parent_writable" "$owner"
}

cmd_doctor() {
  local uid euid username home pmsec_home pmsec_home_src
  uid=$(id -u 2>/dev/null || echo "")
  euid=$(id -u 2>/dev/null || echo "")  # bash has no portable euid; id -u returns euid on POSIX
  username=$(id -un 2>/dev/null || echo "")
  home="$HOME"
  if [ -n "${PMSEC_HOME:-}" ]; then
    pmsec_home="$PMSEC_HOME"; pmsec_home_src="PMSEC_HOME"
  else
    pmsec_home=""; pmsec_home_src="HOME"
  fi
  local rows_json="" first=1 ok_flag=1 t path probe
  local exists writable parent_exists parent_writable owner
  for t in "${SELECTED[@]}"; do
    local extra_members="" ep first_ep=1 blocked_members="" first_bl=1 blocked_extra=()
    if [ "$t" = "mise" ]; then
      mise_doctor_paths; path="$MISE_DOCTOR_PATH"
      if [ "${#MISE_DOCTOR_EXTRA[@]}" -gt 0 ]; then
        extra_members=', "extraPaths": ['
        for ep in "${MISE_DOCTOR_EXTRA[@]}"; do
          [ "$first_ep" = "1" ] || extra_members+=", "
          first_ep=0; extra_members+=$(json_str "$ep")
        done
        # Extra paths pmsec will write (miserc selector, legacy cleanup)
        # block the run just like the primary path when unwritable.
        for ep in "${MISE_DOCTOR_BLOCKING[@]}"; do
          set -- $(_pmsec_probe_path "$ep")
          if [ "$4" = "0" ]; then
            blocked_extra+=("$ep")
            [ "$first_bl" = "1" ] || blocked_members+=", "
            first_bl=0; blocked_members+=$(json_str "$ep")
          fi
        done
        extra_members+='], "blockedExtraPaths": ['"$blocked_members"']'
      fi
    else
      path=$(tool_path "$t")
      MISE_DOCTOR_EXTRA=()
    fi
    probe=$(_pmsec_probe_path "$path")
    set -- $probe
    exists="$1"; writable="$2"; parent_exists="$3"; parent_writable="$4"; owner="${5:-}"
    [ "$parent_writable" = "0" ] && ok_flag=0
    [ "${#blocked_extra[@]}" -gt 0 ] && ok_flag=0
    if [ "$OPT_JSON" = "1" ]; then
      local owner_json
      if [ -z "$owner" ]; then owner_json="null"; else owner_json="$owner"; fi
      [ "$first" = "1" ] || rows_json+=','$'\n'
      first=0
      rows_json+=$'    {'
      rows_json+="\"tool\": $(json_str "$t"), "
      rows_json+="\"key\": $(json_str "$(tool_key "$t")"), "
      rows_json+="\"path\": $(json_str "$path"), "
      rows_json+="\"parent\": $(json_str "$(dirname -- "$path")"), "
      rows_json+="\"exists\": $(json_bool "$exists"), "
      rows_json+="\"writable\": $(json_bool "$writable"), "
      rows_json+="\"parentExists\": $(json_bool "$parent_exists"), "
      rows_json+="\"parentWritable\": $(json_bool "$parent_writable"), "
      rows_json+="\"owner\": $owner_json$extra_members}"
    else
      local flag owner_suffix=""
      if [ "$parent_writable" = "1" ] && [ "${#blocked_extra[@]}" = "0" ]; then flag="ok    "; else flag="BLOCK "; fi
      [ "$exists" = "1" ] && [ -n "$owner" ] && owner_suffix=" (uid=$owner)"
      printf '%s %s %s%s\n' "$flag" "$(pad4 "$t")" "$path" "$owner_suffix"
      for ep in "${MISE_DOCTOR_EXTRA[@]}"; do printf '         also: %s\n' "$ep"; done
      [ "$parent_writable" = "0" ] && \
        printf '         no writable ancestor for %s\n' "$(dirname -- "$path")"
      for ep in "${blocked_extra[@]}"; do printf '         no writable ancestor for %s\n' "$(dirname -- "$ep")"; done
    fi
  done
  if [ "$OPT_JSON" = "1" ]; then
    local pmsec_home_json ok_json
    if [ -z "$pmsec_home" ]; then pmsec_home_json="null"; else pmsec_home_json=$(json_str "$pmsec_home"); fi
    if [ "$ok_flag" = "1" ]; then ok_json="true"; else ok_json="false"; fi
    local username_json
    if [ -z "$username" ]; then username_json="null"; else username_json=$(json_str "$username"); fi
    local platform="${PMSEC_PLATFORM:-}"
    [ -z "$platform" ] && platform=$(uname -s 2>/dev/null | tr '[:upper:]' '[:lower:]')
    printf '{\n'
    printf '  "doctor": true,\n'
    printf '  "version": %s,\n' "$(json_str "$PMSEC_VERSION")"
    printf '  "platform": %s,\n' "$(json_str "$platform")"
    printf '  "uid": %s,\n' "${uid:-null}"
    printf '  "euid": %s,\n' "${euid:-null}"
    printf '  "username": %s,\n' "$username_json"
    printf '  "home": %s,\n' "$(json_str "$home")"
    printf '  "pmsecHome": %s,\n' "$pmsec_home_json"
    printf '  "pmsecHomeSource": %s,\n' "$(json_str "$pmsec_home_src")"
    printf '  "tools": [\n%s\n  ],\n' "$rows_json"
    printf '  "ok": %s\n}\n' "$ok_json"
  else
    # Render the header before the per-tool rows we already printed — the
    # human renderer is two-pass to avoid buffering, so prepend nothing now.
    :
  fi
  [ "$ok_flag" = "1" ] && return 0 || return 1
}

# Two-pass human renderer for doctor: print header first, then re-run the
# per-tool loop. Cheap, avoids buffering, keeps cmd_doctor symmetric with
# cmd_check / cmd_enable. Called only in human mode.
_doctor_print_header() {
  local platform="${PMSEC_PLATFORM:-}"
  [ -z "$platform" ] && platform=$(uname -s 2>/dev/null | tr '[:upper:]' '[:lower:]')
  printf 'pmsec %s  doctor\n' "$PMSEC_VERSION"
  printf '  platform   : %s\n' "$platform"
  local uid_str euid_str username
  uid_str=$(id -u 2>/dev/null || echo "?")
  euid_str="$uid_str"
  username=$(id -un 2>/dev/null || echo "")
  if [ -n "$username" ]; then
    printf '  uid/euid   : %s/%s (%s)\n' "$uid_str" "$euid_str" "$username"
  else
    printf '  uid/euid   : %s/%s\n' "$uid_str" "$euid_str"
  fi
  printf '  HOME       : %s\n' "$HOME"
  if [ -n "${PMSEC_HOME:-}" ]; then
    printf '  PMSEC_HOME : %s\n\n' "$PMSEC_HOME"
  else
    printf '  PMSEC_HOME : (unset \xe2\x80\x94 using HOME)\n\n'
  fi
}

main() {
  parse_args "$@" || return $?
  if [ "$OPT_VERSION" = "1" ]; then printf 'pmsec %s\n' "$PMSEC_VERSION"; return 0; fi
  if [ "$OPT_HELP" = "1" ]; then USAGE; return 0; fi
  select_tools || return $?
  case "$MODE" in
    check)   cmd_check ;;
    disable) cmd_disable ;;
    enable)  cmd_enable ;;
    doctor)
      [ "$OPT_JSON" = "1" ] || _doctor_print_header
      cmd_doctor ;;
  esac
}

main "$@"
